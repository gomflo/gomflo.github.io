---
/**
 * Motivo animado de cada herramienta. Cada SVG tiene un estado de reposo y un
 * estado "en juego" que representa la transformación que hace la herramienta.
 * El estado en juego se activa desde un ancestro `.motif-trigger`
 * (hover, focus-visible o atributo `data-play`). Ver src/styles/motifs.css.
 */
import type { ToolSlug } from "@/lib/tools";

interface Props {
  slug: ToolSlug;
  class?: string;
}

const { slug, class: className } = Astro.props;
---

<svg
  class:list={["motif", className]}
  data-motif={slug}
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="3.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {slug === "formatear-json" && (
    <>
      <g class="m-dots" fill="currentColor" stroke="none">
        <circle cx="27.5" cy="32" r="1.8" />
        <circle cx="32" cy="32" r="1.8" />
        <circle cx="36.5" cy="32" r="1.8" />
      </g>
      <path class="m-line m-line-1" pathLength="1" d="M22 22h12" />
      <path class="m-line m-line-2 m-accent" pathLength="1" d="M28 32h14" />
      <path class="m-line m-line-3" pathLength="1" d="M22 42h8" />
      <path class="m-brace m-brace-l" d="M27 14q-6 0-6 6v6q0 4-4 6q4 2 4 6v6q0 6 6 6" />
      <path class="m-brace m-brace-r" d="M37 14q6 0 6 6v6q0 4 4 6q-4 2-4 6v6q0 6-6 6" />
    </>
  )}

  {slug === "decodificar-jwt" && (
    <g stroke="none">
      <rect class="m-seg m-seg-1" x="6" y="28" width="14" height="8" rx="2.5" fill="currentColor" />
      <rect class="m-seg m-seg-2" x="23" y="28" width="18" height="8" rx="2.5" fill="currentColor" />
      <rect class="m-seg m-seg-3" x="44" y="28" width="14" height="8" rx="2.5" fill="currentColor" />
      <circle class="m-sep m-sep-1" cx="21.5" cy="32" r="1.5" fill="currentColor" />
      <circle class="m-sep m-sep-2" cx="42.5" cy="32" r="1.5" fill="currentColor" />
    </g>
  )}

  {slug === "base64-archivo" && (
    <>
      <path d="M17 8h21l10 10v38H17z" />
      <path d="M38 8v10h10" />
      <g class="m-text">
        <path d="M24 30h17" />
        <path d="M24 38h17" />
        <path d="M24 46h10" />
      </g>
      <g class="m-bits" stroke="none" fill="currentColor">
        {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => (
          <rect
            class:list={["m-bit", { "m-accent-fill": i === 1 || i === 5 || i === 6 }]}
            x={23 + (i % 3) * 7}
            y={27 + Math.floor(i / 3) * 7}
            width="5"
            height="5"
            rx="1"
            style={`--i:${i}`}
          />
        ))}
      </g>
    </>
  )}

  {slug === "contar-caracteres" && (
    <>
      {[16, 24, 32, 40].map((x, i) => (
        <path class="m-tally" pathLength="1" d={`M${x} 16v32`} style={`--i:${i}`} />
      ))}
      <path class="m-strike m-accent" pathLength="1" d="M9 43L47 21" style="--i:4" />
    </>
  )}

  {slug === "remover-acentos" && (
    <>
      <g class="m-letter">
        <circle cx="29" cy="41" r="10" />
        <path d="M39 30v21" />
      </g>
      <path class="m-tilde m-accent" stroke-width="4.5" d="M27 22l9-9" />
    </>
  )}

  {slug === "ordenar-lista" && (
    <g stroke-width="5">
      <path class="m-bar m-bar-1" d="M12 16h30" />
      <path class="m-bar m-bar-2" d="M12 26h14" />
      <path class="m-bar m-bar-3 m-accent" d="M12 36h40" />
      <path class="m-bar m-bar-4" d="M12 46h22" />
    </g>
  )}

  {slug === "conversor-cron" && (
    <>
      <circle cx="32" cy="35" r="20" />
      <g stroke-width="3">
        <path d="M32 19v3" />
        <path d="M48 35h-3" />
        <path d="M32 51v-3" />
        <path d="M16 35h3" />
      </g>
      <path class="m-hand" d="M32 35V24" />
      <path class="m-hand-short" d="M32 35h7" />
      <circle cx="32" cy="35" r="2" fill="currentColor" stroke="none" />
      <circle class="m-bell m-accent-fill" cx="32" cy="7" r="3.5" fill="currentColor" stroke="none" />
    </>
  )}

  {slug === "comparar-diff" && (
    <>
      <rect class="m-hl m-hl-l" x="5" y="24" width="24" height="8" rx="2" fill="currentColor" stroke="none" />
      <rect class="m-hl m-hl-r m-accent-fill" x="35" y="34" width="24" height="8" rx="2" fill="currentColor" stroke="none" />
      <path d="M32 10v44" stroke-width="2" stroke-dasharray="2 5" />
      <path d="M8 18h18M8 28h14M8 38h18M8 48h10" />
      <path d="M38 18h18M38 28h14M38 48h12" />
      <path class="m-line m-accent" pathLength="1" d="M38 38h16" />
    </>
  )}

  {slug === "user-agent" && (
    <>
      <rect x="7" y="11" width="50" height="42" rx="6" />
      <path d="M7 22h50" />
      <g fill="currentColor" stroke="none">
        <circle cx="14" cy="16.5" r="1.8" />
        <circle cx="20" cy="16.5" r="1.8" />
        <circle cx="26" cy="16.5" r="1.8" />
      </g>
      <g class="m-ua-text" stroke-width="3">
        <path d="M15 31h22" />
        <path d="M15 39h32" />
        <path d="M15 46h14" />
      </g>
      <path class="m-scan m-accent" d="M12 28h40" />
    </>
  )}

  {slug === "generador-contrasenas" && (
    <>
      <path class="m-shackle" d="M22 30v-8a10 10 0 0 1 20 0v8" />
      <rect x="13" y="30" width="38" height="25" rx="6" />
      <g fill="currentColor" stroke="none">
        <circle class="m-pin" cx="23" cy="42.5" r="2.8" style="--i:0" />
        <circle class="m-pin m-accent-fill" cx="32" cy="42.5" r="2.8" style="--i:1" />
        <circle class="m-pin" cx="41" cy="42.5" r="2.8" style="--i:2" />
      </g>
    </>
  )}

  {slug === "generador-uuid" && (
    <g class="m-dice">
      <rect x="12" y="12" width="40" height="40" rx="9" />
      <g class="m-face-a" fill="currentColor" stroke="none">
        <circle cx="22" cy="22" r="3.3" />
        <circle cx="42" cy="22" r="3.3" />
        <circle cx="32" cy="32" r="3.3" />
        <circle cx="22" cy="42" r="3.3" />
        <circle cx="42" cy="42" r="3.3" />
      </g>
      <g class="m-face-b m-accent-fill" stroke="none">
        <circle cx="22" cy="21" r="3.3" />
        <circle cx="22" cy="32" r="3.3" />
        <circle cx="22" cy="43" r="3.3" />
        <circle cx="42" cy="21" r="3.3" />
        <circle cx="42" cy="32" r="3.3" />
        <circle cx="42" cy="43" r="3.3" />
      </g>
    </g>
  )}

  {slug === "convertir-mayusculas-minusculas" && (
    <>
      <path class="m-cap" d="M7 50L18 16L29 50M11.5 38h13" />
      <g class="m-low">
        <circle cx="43" cy="42" r="8" />
        <path d="M51 34v16" />
      </g>
    </>
  )}

  {slug === "codificar-url" && (
    <>
      <path class="m-link-l" d="M28 36l-6 6a7 7 0 0 1-10-10l6-6a7 7 0 0 1 10 0" />
      <path class="m-link-r" d="M36 28l6-6a7 7 0 0 1 10 10l-6 6a7 7 0 0 1-10 0" />
      <path class="m-link-mid" d="M26 38l12-12" />
      <g class="m-pct">
        <circle class="m-accent" cx="26.5" cy="26.5" r="3" />
        <circle class="m-accent" cx="37.5" cy="37.5" r="3" />
        <path class="m-accent" d="M39 25L25 39" />
      </g>
    </>
  )}

  {slug === "base64-texto" && (
    <>
      <rect x="6" y="11" width="52" height="42" rx="8" />
      <path class="m-row" d="M15 23h34" />
      <path class="m-row" d="M15 32h26" style="--i:1" />
      <path class="m-row" d="M15 41h16" style="--i:2" />
      <g class="m-pad m-accent" stroke-width="3">
        <path d="M38 39h10" />
        <path d="M38 44h10" />
      </g>
    </>
  )}

  {slug === "timestamp-unix" && (
    <>
      <rect x="9" y="13" width="46" height="41" rx="6" />
      <path d="M9 25h46" />
      <path d="M21 8v9M43 8v9" />
      <g class="m-sheet" fill="currentColor" stroke="none">
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
          <circle cx={18 + (i % 4) * 9.3} cy={i < 4 ? 34 : 44} r="2.6" />
        ))}
        <circle class="m-day m-day-a m-accent-fill" cx="27.3" cy="34" r="3.6" />
        <circle class="m-day m-day-b m-accent-fill" cx="36.6" cy="44" r="3.6" />
      </g>
    </>
  )}

  {slug === "generador-hash" && (
    <>
      <rect class="m-digest m-accent-fill" x="25.5" y="28" width="13" height="9" rx="2" stroke="none" fill="currentColor" />
      <path class="m-hv m-hv-1" d="M25 11L21 53" />
      <path class="m-hv m-hv-2" d="M43 11L39 53" />
      <path class="m-hh m-hh-1" d="M11 24h43" />
      <path class="m-hh m-hh-2" d="M9 41h43" />
    </>
  )}

  {slug === "numeros-a-letras" && (
    <>
      <g class="m-digits">
        <path d="M15 13l6-4v22" />
        <path d="M30 14a6 6 0 0 1 12 1c0 5-12 10-12 16h12" />
      </g>
      <path class="m-baseline" d="M8 55h48" stroke-width="2" stroke-dasharray="1 5" />
      <path
        class="m-script m-accent"
        pathLength="1"
        d="M8 47c3-9 7-9 7-1s3 5 6-1 5-6 6 0 3 7 6 0 5-9 7-2 3 6 6 1 3-3 7-1"
      />
    </>
  )}

  {slug === "conversor-colores" && (
    <>
      <rect class="m-chip m-chip-1" x="26" y="8" width="12" height="42" rx="4" />
      <rect class="m-chip m-chip-3" x="26" y="8" width="12" height="42" rx="4" fill="currentColor" />
      <rect class="m-chip m-chip-2 m-accent-fill" x="26" y="8" width="12" height="42" rx="4" fill="currentColor" />
      <circle cx="32" cy="44" r="2.2" fill="var(--glaze-raised)" stroke="none" />
    </>
  )}

  {slug === "validar-clabe" && (
    <>
      <rect x="6" y="13" width="50" height="36" rx="6" />
      <rect x="13" y="21" width="10" height="8" rx="2" stroke-width="3" />
      <g class="m-cl-digits" stroke-width="3">
        <path d="M13 39h7" />
        <path d="M24 39h7" style="--i:1" />
        <path d="M35 39h4" style="--i:2" />
      </g>
      <g class="m-cl-badge">
        <circle class="m-accent-fill" cx="49" cy="46" r="10" fill="currentColor" stroke="none" />
        <path class="m-cl-check" pathLength="1" d="M44.5 46.5l3 3 6-6.5" stroke="var(--yolk-ink)" stroke-width="3" />
      </g>
    </>
  )}

  {slug === "calculadora-iva" && (
    <g class="m-iva-tag">
      <path d="M34 9h19a2 2 0 0 1 2 2v19L31 54a3 3 0 0 1-4.2 0L10 37.2a3 3 0 0 1 0-4.2z" />
      <circle cx="46" cy="18" r="3" stroke-width="3" />
      <g class="m-iva-pct" stroke-width="3">
        <circle cx="26.5" cy="31.5" r="2.6" />
        <circle cx="35.5" cy="40.5" r="2.6" />
        <path d="M37 30L25 42" />
      </g>
    </g>
  )}

  {slug === "dias-habiles" && (
    <>
      {[0, 1, 2, 3, 4, 5, 6].map((i) => (
        <rect
          class:list={["m-wk", i < 5 ? "m-wk-on" : "m-wk-off"]}
          x={3.5 + i * 8.5}
          y={i < 5 ? 18 : 30}
          width="6"
          height={i < 5 ? 28 : 16}
          rx="3"
          stroke-width="2.5"
          style={`--i:${i}`}
        />
      ))}
      <path d="M3 53h58" stroke-width="2" stroke-dasharray="1 5" />
    </>
  )}

  {slug === "numeros-romanos" && (
    <>
      <path d="M6 11h52M6 53h52" stroke-width="2" />
      <path class="m-ro m-ro-1" d="M13 19v26M9 19h8M9 45h8" />
      <path class="m-ro m-ro-2" d="M22 19l8 26l8-26" />
      <path class="m-ro m-ro-3" d="M44 19l12 26M56 19l-12 26" />
    </>
  )}

  {slug === "codigo-morse" && (
    <g fill="currentColor" stroke="none">
      <circle class="m-mo" cx="9" cy="32" r="4" style="--i:0" />
      <rect class="m-mo" x="16" y="28" width="15" height="8" rx="4" style="--i:1" />
      <circle class="m-mo" cx="38" cy="32" r="4" style="--i:2" />
      <rect class="m-mo" x="45" y="28" width="15" height="8" rx="4" style="--i:3" />
    </g>
  )}

  {slug === "texto-a-binario" && (
    <>
      <path class="m-bin-a" d="M19 50L32 14L45 50M23.5 38h17" />
      <g class="m-bin-bits">
        <path class="m-bin-bit" d="M16 15l5-3v18" style="--i:0" />
        <rect class="m-bin-bit" x="33" y="12" width="12" height="18" rx="6" style="--i:1" />
        <rect class="m-bin-bit m-accent" x="17" y="34" width="12" height="18" rx="6" style="--i:2" />
        <path class="m-bin-bit" d="M38 37l5-3v18" style="--i:3" />
      </g>
    </>
  )}
</svg>
