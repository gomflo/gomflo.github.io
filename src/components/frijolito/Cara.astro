---
// Una carta (de feria, salvo que se pase `src`), como la dibuja la app: papel, ilustración, el número en la esquina y,
// en rejillas y tablas, la placa con el nombre al pie. Su gemela en React está en Cara.tsx.
import { imagen, textoAlt, type Carta } from "../../data/frijolito-cartas";

interface Props {
  carta: Carta;
  placa?: boolean;
  /** Las de arriba de la página no esperan al scroll. */
  lazy?: boolean;
  /** Texto alternativo en otro idioma (la portada en inglés); sin él, el de la baraja en español. */
  alt?: string;
  /** La ilustración de otra baraja (las muestras de la de posada); sin ella, la de feria. */
  src?: string;
  /** Baraja de fondo oscuro: el número va sobre papel, como en la app (CardStyle.dark). */
  oscura?: boolean;
  /** Ancho en pantalla (atributo sizes): con él, la de feria trae también su copia de 208 px (cartas/chica/). */
  sizes?: string;
}

const { carta, placa = true, lazy = true, alt, src, oscura = false, sizes } = Astro.props;
const chica = !src && sizes ? imagen(carta).replace("/cartas/", "/cartas/chica/") : undefined;
---

<div class:list={["fj-cara", { "fj-cara--oscura": oscura }]}>
  <div class="fj-cara__dibujo">
    <img
      src={src ?? imagen(carta)}
      srcset={chica && `${chica} 208w, ${imagen(carta)} 300w`}
      sizes={chica && sizes}
      alt={alt ?? textoAlt(carta)}
      width="300"
      height="450"
      loading={lazy ? "lazy" : "eager"}
      decoding="async"
    />
    <span class="fj-cara__numero" aria-hidden="true">{carta.n}</span>
  </div>
  {placa && <span class="fj-cara__placa" aria-hidden="true">{carta.nombre}</span>}
</div>
