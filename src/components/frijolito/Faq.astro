---
// Preguntas frecuentes, abiertas una por una. El JSON-LD (FAQPage) lo arma cada página con las mismas.
// `enlace` vuelve enlace la primera vez que su texto aparece en la respuesta; el JSON-LD se queda con `a` tal cual.
export interface Faq {
  q: string;
  a: string;
  enlace?: { texto: string; href: string };
}

interface Props {
  faq: Faq[];
  titulo?: string;
}

const { faq, titulo = "Preguntas frecuentes" } = Astro.props;
---

<section class="fj-seccion fj-marco" aria-labelledby="faq-titulo">
  <h2 id="faq-titulo" class="fj-seccion__titulo">{titulo}</h2>
  <div class="fj-faq">
    {
      faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>
            {f.enlace && f.a.includes(f.enlace.texto) ? (
              <>
                {f.a.slice(0, f.a.indexOf(f.enlace.texto))}
                <a class="fj-enlace" href={f.enlace.href}>{f.enlace.texto}</a>
                {f.a.slice(f.a.indexOf(f.enlace.texto) + f.enlace.texto.length)}
              </>
            ) : (
              f.a
            )}
          </p>
        </details>
      ))
    }
  </div>
</section>
