---
// El bloque de papel de la app para Android: lo que trae de más y el enlace a Google Play con sus capturas.
import { androidApps } from "../../data/android-apps";
import { playLink } from "../../lib/play";

interface Props {
  titulo?: string;
  puntos?: string[];
  /** utm_campaign del enlace a Google Play. */
  campaign: string;
  /** Textos fijos del bloque en otro idioma (la portada en inglés). */
  rotulo?: string;
  boton?: string;
  letra?: string;
  capturas?: { src: string; alt: string }[];
}

const {
  titulo = "En el teléfono, Frijolito canta toda la noche.",
  puntos = [
    "Dos voces de cantador, Ramón y Jess, que suenan igual en cualquier teléfono",
    "Cuatro barajas ilustradas: de feria, grabado en linóleo, neón y papel picado",
    "Tablas en el teléfono que se marcan con frijolitos y avisan cuando hay línea, esquinas, pozo, marco o tabla llena",
    "Tablas en PDF tamaño carta, distintas entre sí, una, dos o cuatro por hoja, con líneas punteadas para cortar",
    "Adivinanza: primero el verso, con la carta boca abajo",
    "Funciona sin internet, sin anuncios y sin cuenta",
  ],
  campaign,
  rotulo = "Lotería Mexicana: Frijolito, para Android",
  boton = "Bájala gratis en Google Play",
  letra = "Gratis con la baraja de feria y PDF de hasta 4 tablas. Las voces de Ramón y Jess (sintéticas), las otras tres barajas y los PDF de hasta 40 tablas sin la marca de la app vienen con Pro, un pago único y opcional.",
  capturas = [
    { src: "mesa", alt: "Frijolito en el teléfono canta la carta 1, El Gallo, con su verso, sobre la mesa azul" },
    { src: "tabla", alt: "Una tabla de lotería en Frijolito marcada con frijolitos, con el aviso de ¡Lotería!" },
    { src: "barajas", alt: "Los ajustes de Frijolito con las cuatro barajas: de feria, grabado, neón y papel picado" },
  ],
} = Astro.props;
const play = playLink(androidApps.find((a) => a.slug === "frijolito")!.play!, campaign);
---

<div class="fj-marco">
  <section class="fj-app" aria-labelledby="app-titulo">
    <div>
      <p class="fj-rotulo" style="color:#5b5048">{rotulo}</p>
      <h2 id="app-titulo" style="margin-top:0.5rem">{titulo}</h2>
      <ul>
        {puntos.map((p) => <li>{p}</li>)}
      </ul>
      <a class="fj-boton" href={play} rel="noopener">{boton}</a>
      <p class="fj-app__letra">{letra}</p>
    </div>
    <div class="fj-app__capturas">
      {capturas.map((c) => <img src={`/img/frijolito/${c.src.includes("/") ? c.src : `captura-${c.src}`}.webp`} alt={c.alt} width="540" height="1212" loading="lazy" decoding="async" />)}
    </div>
  </section>
</div>
