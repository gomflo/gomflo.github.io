---
/**
 * La caja de piezas: todas las herramientas en una lista de dos extremos,
 * agrupadas por categoría. El color de la categoría queda en un punto chico;
 * a la izquierda el nombre y lo que hace, a la derecha su resultado en vivo.
 * La usan el inicio y el 404. El buscador (src/motion/buscador.ts) filtra por
 * `data-pieza` y cada fila muestra su resultado en vivo (src/motion/piezas.ts, `data-vivo`).
 */
import { categories, toolsIn } from "../lib/tools";

interface Props {
  /** Nivel de encabezado de cada categoría. */
  level?: 2 | 3;
}

const { level = 3 } = Astro.props;
const Titulo = `h${level}` as "h2" | "h3";
---

<div class="piezas" data-piezas>
  {categories.map((category) => {
    const lista = toolsIn(category.id);
    return (
      <section class="grupo" data-grupo data-cat={category.id} aria-labelledby={`grupo-${category.id}`}>
        <Titulo id={`grupo-${category.id}`} class="grupo__titulo">{category.title}</Titulo>
        <ul class="grupo__lista" role="list">
          {lista.map((tool) => (
            <li data-pieza={`${tool.title} ${tool.desc} ${category.title}`} data-entra>
              <a href={tool.href} class="fila" data-cat={category.id}>
                <span class="fila__punto" aria-hidden="true" />
                <span class="fila__nombre" data-nombre>{tool.title}</span>
                <span class="fila__desc">{tool.desc}</span>
                <code class="fila__vivo" data-vivo={tool.slug} data-muestra-color={tool.slug === "conversor-colores" ? "" : undefined} aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</div>

<style>
  .piezas {
    display: grid;
    gap: clamp(2rem, 3vw, 2.75rem);
  }

  .grupo[hidden],
  .grupo__lista > li[hidden] {
    display: none;
  }

  /* La categoría: una palabra en la tinta suave, al tamaño del texto. */
  .grupo__titulo {
    margin: 0 0 0.375rem;
    padding-inline: 0.75rem;
    color: var(--gris);
    font-size: var(--t-texto);
    font-weight: 500;
    line-height: 1.4;
  }

  .grupo__lista {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* La fila: sin caja ni línea; al apuntarla sube un tono. */
  .fila {
    display: grid;
    grid-template-columns: 0.625rem minmax(0, 14.5rem) minmax(0, 1fr) minmax(0, 14rem);
    align-items: baseline;
    gap: 0 1rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    color: var(--tinta);
    text-decoration: none;
    border-radius: var(--radio-sobrio);
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.18s var(--ease-soft);
  }
  @media (hover: hover) {
    .fila:hover {
      background: var(--crema-honda);
    }
    .fila:hover .fila__vivo {
      color: var(--tinta);
    }
  }
  .fila:active {
    background: var(--crema-honda);
  }
  .fila:focus-visible {
    background: var(--crema-honda);
    border-radius: var(--radio-sobrio);
  }

  /* El punto se alinea con la primera línea del nombre. */
  .fila__punto {
    align-self: start;
    margin-top: 0.4rem;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--pieza);
    transition: scale 0.3s var(--ease-spring);
  }
  @media (hover: hover) {
    .fila:hover .fila__punto {
      scale: 1.4;
    }
  }

  .fila__nombre {
    font-size: var(--t-texto);
    font-weight: 600;
    line-height: 1.35;
  }

  .fila__desc {
    color: var(--gris);
    font-size: var(--t-texto);
    line-height: 1.4;
  }

  /* El resultado en vivo: código de verdad, en una línea, alineado a la derecha. */
  .fila__vivo {
    justify-self: end;
    max-width: 100%;
    overflow: hidden;
    color: var(--gris);
    font-family: var(--font-code);
    font-size: var(--t-chico);
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: color 0.18s var(--ease-soft);
  }
  .fila__vivo[data-muestra-color]::before {
    content: "";
    display: inline-block;
    width: 0.625rem;
    height: 0.625rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--muestra, var(--lila));
  }
  @keyframes vivo {
    from {
      opacity: 0.2;
    }
  }
  :global(.motion) .fila__vivo:global(.cambia) {
    animation: vivo 0.5s var(--ease-soft);
  }

  @media (max-width: 1100px) {
    .fila {
      grid-template-columns: 0.625rem minmax(0, 1fr) minmax(0, 13rem);
      row-gap: 0.1rem;
    }
    .fila__desc {
      grid-column: 2;
      grid-row: 2;
    }
    .fila__vivo {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @media (max-width: 640px) {
    .fila {
      grid-template-columns: 0.625rem minmax(0, 1fr);
      padding-block: 0.75rem;
    }
    .fila__nombre,
    .fila__desc,
    .fila__vivo {
      grid-column: 2;
      grid-row: auto;
    }
    .fila__vivo {
      justify-self: start;
      margin-top: 0.2rem;
    }
  }
</style>
