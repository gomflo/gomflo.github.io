---
/**
 * La caja de piezas: todas las herramientas como bloques de color, agrupadas
 * por categoría (el color es la categoría). La usan el inicio y el 404.
 * El buscador (src/motion/buscador.ts) filtra por `data-pieza` y cada bloque
 * muestra su resultado en vivo (src/motion/piezas.ts, `data-vivo`).
 */
import Motif from "./brand/Motif.astro";
import { categories, toolsIn } from "../lib/tools";

interface Props {
  /** Nivel de encabezado de cada categoría. */
  level?: 2 | 3;
}

const { level = 3 } = Astro.props;
const Titulo = `h${level}` as "h2" | "h3";
---

<div class="piezas" data-piezas>
  {categories.map((category) => {
    const lista = toolsIn(category.id);
    return (
      <section class="grupo" data-grupo data-cat={category.id} data-n={lista.length} aria-labelledby={`grupo-${category.id}`}>
        <header class="grupo__cabeza" data-entra>
          <p class="grupo__cuenta etiqueta"><span class="grupo__punto" aria-hidden="true" />{lista.length} piezas</p>
          <Titulo id={`grupo-${category.id}`} class="grupo__titulo titular">{category.title}</Titulo>
          <p class="grupo__desc">{category.desc}</p>
        </header>
        <ul class="grupo__lista" role="list">
          {lista.map((tool) => (
            <li data-pieza={`${tool.title} ${tool.desc} ${category.title}`} data-entra>
              <a href={tool.href} class="pieza motif-trigger" data-cat={category.id}>
                <span class="pieza__arriba">
                  <Motif slug={tool.slug} class="pieza__dibujo" />
                  <span class="pieza__flecha" aria-hidden="true">
                    <svg viewBox="0 0 16 16" focusable="false"><path d="M4.5 11.5l7-7M5.5 4.5h6v6" /></svg>
                  </span>
                </span>
                <span class="pieza__nombre">{tool.title}</span>
                <span class="pieza__desc">{tool.desc}</span>
                <span class="pieza__vivo" data-vivo={tool.slug} data-muestra-color={tool.slug === "conversor-colores" ? "" : undefined} aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</div>

<style>
  /*
   * Una sola retícula para todo: secciones y listas son `display: contents`,
   * así la cabeza de cada categoría es un bloque más de la caja.
   */
  .piezas {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--hueco);
  }

  .grupo,
  .grupo__lista {
    display: contents;
  }

  .grupo[hidden],
  .grupo__lista > li[hidden] {
    display: none;
  }

  .grupo__lista {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grupo__lista > li {
    display: grid;
    min-width: 0;
  }

  /* Cabeza de categoría: bloque sin relleno, con el contorno de la tinta.
     Con 6 piezas ocupa dos celdas y con 3 una: cada categoría cierra sus filas. */
  .grupo__cabeza {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 12.5rem;
    padding: clamp(0.875rem, 0.7rem + 0.7vw, 1.25rem);
    border: 2px solid var(--tinta);
    border-radius: var(--radio-pieza);
  }
  .grupo[data-n="3"] .grupo__cabeza {
    grid-column: span 1;
  }

  .grupo__cuenta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }
  .grupo__punto {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: var(--pieza);
    box-shadow: 0 0 0 2px var(--tinta);
  }

  .grupo__titulo {
    margin: auto 0 0;
    padding-top: 1.5rem;
    font-size: var(--t-l);
    overflow-wrap: anywhere;
  }
  .grupo[data-n="3"] .grupo__titulo {
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.875rem);
  }

  .grupo__desc {
    margin: 0.5rem 0 0;
    max-width: 34ch;
    color: var(--gris);
    font-size: var(--t-s);
    line-height: 1.35;
  }

  /* Al filtrar, las cabezas estorban: quedan solo las piezas que coinciden. */
  .piezas[data-filtrando] .grupo__cabeza {
    display: none;
  }

  @media (max-width: 1100px) {
    .piezas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .grupo__cabeza,
    .grupo[data-n="3"] .grupo__cabeza {
      grid-column: 1 / -1;
      min-height: 0;
    }
    .grupo__titulo {
      padding-top: 1rem;
    }
  }

  @media (max-width: 760px) {
    .piezas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* Tres piezas en dos columnas: la última ocupa la fila. */
    .piezas:not([data-filtrando]) .grupo[data-n="3"] li:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 460px) {
    .piezas {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
