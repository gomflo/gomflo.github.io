---
import { existsSync } from "node:fs";
import Layout from "./Layout.astro";
import Motif from "@/components/brand/Motif.astro";
import { ThemeAwareToaster } from "@/components/ui/sonner";
import { getCategory, getTool, toolsIn, variantsOf, type ToolSlug, type VariantSlug } from "@/lib/tools";

export interface Faq {
  q: string;
  a: string;
  /** Fuentes de la respuesta (leyes, datos oficiales): salen como enlaces debajo. */
  fuentes?: { texto: string; href: string }[];
}

interface Props {
  /** Herramienta de la página: define el dibujo, la categoría y las relacionadas. */
  slug: ToolSlug;
  /** Si la página es una variante (página satélite) de la herramienta. */
  variant?: VariantSlug;
  /** Título del documento (pestaña y buscadores). */
  metaTitle: string;
  description: string;
  heading: string;
  lead: string;
  /** Nombre accesible de la sección de la herramienta. */
  sectionLabel: string;
  /** Preguntas frecuentes: se muestran y se publican como FAQPage. */
  faq?: Faq[];
  /** Avisos (Sonner) para copiar y errores. Una herramienta sin React los apaga y no carga React. */
  avisos?: boolean;
}

const { slug, variant, metaTitle, description, heading, lead, sectionLabel, faq = [], avisos = true } = Astro.props;
const tool = getTool(slug);
const category = getCategory(tool.category);
const pageSlug = variant ?? slug;
// La madre enlaza a sus variantes y la variante a su madre, antes que al resto de la categoría.
const siblings = variant
  ? [{ slug, href: tool.href, title: tool.title }]
  : variantsOf(slug).map((v) => ({ slug, href: v.href, title: v.title }));
const related = [
  ...siblings,
  ...toolsIn(tool.category)
    .filter((t) => t.slug !== slug)
    .map((t) => ({ slug: t.slug, href: t.href, title: t.title })),
];
const headingId = `${pageSlug}-heading`;

const imagePath = `/img/${pageSlug}.jpeg`;
const image = existsSync(new URL(`../../public${imagePath}`, import.meta.url)) ? imagePath : undefined;

const pageURL = new URL(Astro.url.pathname, Astro.site).href;
const siteURL = new URL("/", Astro.site).href;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: heading,
    url: pageURL,
    description,
    inLanguage: "es-MX",
    applicationCategory: tool.category === "codigo" ? "DeveloperApplication" : "UtilitiesApplication",
    operatingSystem: "Web",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Herramientas", item: siteURL },
      { "@type": "ListItem", position: 2, name: heading, item: pageURL },
    ],
  },
  ...(faq.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faq.map(({ q, a }) => ({
            "@type": "Question",
            name: q,
            acceptedAnswer: { "@type": "Answer", text: a },
          })),
        },
      ]
    : []),
];
const jsonLd = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<Layout title={metaTitle} description={description} image={image} imageAlt={heading} section="herramientas">
  <main id="main-content" class="herramienta contenedor" data-cat={tool.category} tabindex="-1">
    <!-- La cabeza: la pieza abierta, del color de su categoría. Baja, para que la herramienta quede a la vista. -->
    <header class="pieza cabeza" data-cabeza>
      <div class="cabeza__barra">
        <a href="/#herramientas" class="volver" data-destino="Herramientas">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M10 3L5 8l5 5" />
          </svg>
          Todas las herramientas
        </a>
        <span class="etiqueta cabeza__cat">{category.title}</span>
      </div>
      <div class="cabeza__in">
        <div class="cabeza__texto">
          <h1 class="cabeza__titulo titular">{heading}</h1>
          <p class="cabeza__entrada">{lead}</p>
        </div>
        <div class="cabeza__dibujo" data-motif-stage>
          <Motif slug={slug} />
        </div>
      </div>
    </header>

    <div class="reticula cuerpo">
      <div class="cuerpo__principal">
        <section class="tool-body" aria-labelledby={headingId}>
          <h2 id={headingId} class="sr-only">{sectionLabel}</h2>
          <slot />
        </section>

        <!-- Lo que acompaña a la herramienta fuera del panel (la calculadora de aguinaldo pone aquí el reparto). -->
        <slot name="despues" />

        {faq.length > 0 && (
          <section class="faq" aria-labelledby="faq-heading">
            <h2 id="faq-heading" class="seccion-titulo titular">Preguntas frecuentes</h2>
            <div class="faq-list">
              {faq.map(({ q, a, fuentes }) => (
                <details class="faq-item">
                  <summary>
                    <span>{q}</span>
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path d="M3 8h10M8 3v10" />
                    </svg>
                  </summary>
                  <p>{a}</p>
                  {fuentes && fuentes.length > 0 && (
                    <p class="faq-fuente">
                      {fuentes.length === 1 ? "Fuente: " : "Fuentes: "}
                      {fuentes.map((f, i) => (
                        <>
                          {i > 0 && " y "}
                          <a class="enlace" href={f.href} rel="noopener">{f.texto}</a>
                        </>
                      ))}
                    </p>
                  )}
                </details>
              ))}
            </div>
          </section>
        )}
      </div>

      <nav class="cuerpo__mas" aria-labelledby="more-heading">
        <h2 id="more-heading" class="seccion-titulo titular">Más de {category.title.charAt(0).toLowerCase() + category.title.slice(1)}</h2>
        <ul class="mas-lista" role="list">
          {related.map((t) => (
            <li>
              <a href={t.href} class="pieza pieza--chica motif-trigger" data-cat={tool.category}>
                <Motif slug={t.slug} class="pieza__dibujo" />
                <span class="pieza__nombre">{t.title}</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/#herramientas" class="enlace mas-todas" data-destino="Herramientas">Ver todas las herramientas</a>
      </nav>
    </div>

    <script type="application/ld+json" set:html={jsonLd} />
  </main>
  {avisos && <ThemeAwareToaster slot="after" client:idle />}
</Layout>

<style>
  .cabeza {
    gap: clamp(0.75rem, 2vw, 1.5rem);
    padding: clamp(1rem, 0.8rem + 1.2vw, 1.75rem) clamp(1.125rem, 0.8rem + 2vw, 2.5rem) clamp(1.25rem, 1rem + 1.6vw, 2.25rem);
  }

  .cabeza__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .volver {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    margin-left: -0.75rem;
    padding: 0 0.9rem 0 0.6rem;
    color: inherit;
    font-size: var(--t-s);
    font-weight: 700;
    text-decoration: none;
    border-radius: 0.875rem;
    transition:
      background-color 0.2s var(--ease-soft),
      color 0.2s var(--ease-soft);
  }
  .volver svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.3s var(--ease-out);
  }
  @media (hover: hover) {
    .volver:hover {
      background: var(--tinta-fija);
      color: var(--pieza);
    }
    .volver:hover svg {
      translate: -3px 0;
    }
  }
  .volver:active {
    background: var(--tinta-fija);
    color: var(--pieza);
  }
  .volver:focus-visible {
    outline-color: var(--tinta-fija);
  }

  .cabeza__in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(1rem, 3vw, 2.5rem);
  }

  .cabeza__titulo {
    margin: 0;
    font-size: var(--t-xl);
  }

  .cabeza__entrada {
    margin: 0.75rem 0 0;
    max-width: 56ch;
    font-size: var(--t-m);
    font-weight: 500;
    line-height: 1.3;
  }

  /* El dibujo va en su propia ficha oscura, como la ventanita de la pieza. */
  .cabeza__dibujo {
    --acento-dibujo: var(--pieza);
    flex: none;
    width: clamp(4.5rem, 9vw, 7.5rem);
    padding: clamp(0.6rem, 1.2vw, 1rem);
    background: var(--tinta-fija);
    color: var(--crema-fija);
    border-radius: calc(var(--radio-pieza) * 0.8);
    rotate: 4deg;
    transition: rotate 0.5s var(--ease-spring);
  }
  @media (hover: hover) {
    .cabeza__dibujo:hover {
      rotate: -3deg;
    }
  }

  .cabeza__dibujo :global(.motif) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    stroke-width: 4;
  }

  @media (max-width: 560px) {
    /* En el teléfono manda la herramienta: la cabeza se compacta. */
    .cabeza__cat {
      display: none;
    }
    .cabeza__in {
      align-items: start;
      gap: 0.75rem;
    }
    .cabeza__dibujo {
      width: 3.25rem;
      padding: 0.45rem;
      border-radius: 0.75rem;
    }
    .cabeza__entrada {
      margin-top: 0.5rem;
      font-size: var(--t-body);
    }
  }

  /* ---------- Cuerpo: herramienta a la izquierda, relacionadas pegadas a la derecha ---------- */

  .cuerpo {
    align-items: start;
    column-gap: var(--hueco);
    row-gap: clamp(3rem, 7vw, 5rem);
    padding-top: var(--hueco);
  }

  .cuerpo__principal {
    grid-column: 1 / span 9;
    min-width: 0;
  }

  .cuerpo__mas {
    grid-column: 10 / -1;
    position: sticky;
    top: 1rem;
    padding: clamp(0.875rem, 0.7rem + 0.7vw, 1.25rem);
    border: 2px solid var(--tinta);
    border-radius: var(--radio-pieza);
  }

  /* El panel donde se trabaja: blanco, plano y con el contorno de la tinta. */
  .tool-body {
    padding: clamp(1rem, 2.5vw, 2rem);
    background: var(--panel);
    border: 2px solid var(--tinta);
    border-radius: var(--radio-pieza);
  }

  .seccion-titulo {
    margin: 0 0 0.9rem;
    font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.875rem);
    line-height: 1;
  }

  .faq {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .mas-lista {
    display: grid;
    gap: 0.375rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .mas-lista :global(.pieza__nombre) {
    margin: 0;
    padding: 0;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .mas-todas {
    display: inline-block;
    padding-block: 0.3rem;
    font-size: var(--t-s);
    font-weight: 700;
  }

  @media (max-width: 1000px) {
    .cuerpo__principal,
    .cuerpo__mas {
      grid-column: 1 / -1;
    }
    .cuerpo__mas {
      position: static;
    }
    .mas-lista {
      grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    }
  }

  /* ---------- Preguntas frecuentes: cada una es un bloque que se abre ---------- */

  .faq-list {
    display: grid;
    gap: 0.5rem;
  }

  .faq-item {
    background: var(--crema-honda);
    border-radius: 1rem;
    transition: background-color 0.25s var(--ease-soft);
  }

  .faq-item[open] {
    background: var(--pieza);
    color: var(--tinta-fija);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
    padding: 0.875rem 1rem 0.875rem 1.25rem;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.25;
    cursor: pointer;
    list-style: none;
    border-radius: 1rem;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:focus-visible {
    outline-offset: -3px;
    outline-color: var(--tinta);
  }

  .faq-item summary svg {
    flex: none;
    width: 2rem;
    height: 2rem;
    padding: 0.4rem;
    border-radius: 50%;
    background: var(--tinta);
    fill: none;
    stroke: var(--crema);
    stroke-width: 2.5;
    stroke-linecap: round;
    transition:
      rotate 0.4s var(--ease-spring),
      scale 0.2s var(--ease-soft);
  }

  @media (hover: hover) {
    .faq-item summary:hover svg {
      scale: 1.12;
    }
  }

  .faq-item[open] summary svg {
    rotate: 45deg;
    background: var(--tinta-fija);
    stroke: var(--pieza);
  }

  .faq-item p {
    margin: 0;
    padding: 0 3.5rem 1.25rem 1.25rem;
    max-width: 68ch;
    line-height: 1.55;
  }

  .faq-item p:has(+ .faq-fuente) {
    padding-bottom: 0.5rem;
  }

  .faq-item .faq-fuente {
    font-size: var(--t-s);
  }

  /* Sobre la pieza abierta la raya del enlace va en la tinta fija, como el texto. */
  .faq-fuente .enlace {
    font-weight: 700;
    background-image: linear-gradient(var(--tinta-fija) 0 0);
  }
  @media (hover: hover) {
    .faq-fuente .enlace:hover {
      color: var(--pieza);
    }
  }
  .faq-fuente .enlace:focus-visible {
    color: var(--pieza);
    outline-color: var(--tinta-fija);
  }
</style>
