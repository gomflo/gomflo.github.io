---
// La plantilla de /tinmarin/ y sus guías: identidad de la app (tema Feria, styles/tinmarin.css), sin
// Layout.astro ni global.css. Pone la cabeza (SEO, imagen para compartir, JSON-LD), la barra y el pie.
import { existsSync } from "node:fs";
import "../styles/tinmarin.css";
import { androidApps } from "../data/android-apps";
import { playLink } from "../lib/play";

interface Props {
  title: string;
  description: string;
  /** Imagen para compartir (1200×630) en public/. Si no existe todavía, la página sale sin ella. */
  image: string;
  imageAlt: string;
  jsonLd: object;
  /** utm_campaign de los enlaces a Google Play. */
  campaign: string;
}

const { title, description, image, imageAlt, jsonLd, campaign } = Astro.props;
const site = Astro.site!;
const canonicalURL = new URL(Astro.url.pathname, site).href;
const imageURL = existsSync(new URL(`../../public${image}`, import.meta.url)) ? new URL(image, site).href : undefined;
const play = playLink(androidApps.find((a) => a.slug === "tinmarin")!.play!, campaign);
const inicio = Astro.url.pathname === "/tinmarin/";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFF8EC" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/img/android/tinmarin/icono.png" />
    <link rel="apple-touch-icon" href="/img/android/tinmarin/icono.png" />
    <link rel="preload" href="/fonts/bricolage-grotesque-200_800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-100_1000-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="gomflo.dev" />
    {
      imageURL && (
        <>
          <meta property="og:image" content={imageURL} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={imageAlt} />
        </>
      )
    }
    <meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    {imageURL && <meta name="twitter:image:alt" content={imageAlt} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#ruleta" class="tm-salto">Ir a la ruleta</a>

    <header class="tm-barra marco">
      <a class="tm-marca" href="/tinmarin/" aria-label="Tin Marín, inicio">
        <img src="/img/android/tinmarin/icono.png" alt="" width="36" height="36" />
        Tin Marín
      </a>
      <nav aria-label="Principal">
        <a class="tm-barra__liga" href={inicio ? "#comprobar" : "/tinmarin/#comprobar"}>Comprobar un sorteo</a>
        <a class="tm-play" href={play} rel="noopener" aria-label="Bájala en Google Play">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>
          <span><span class="tm-play__largo">Bájala en </span>Google Play</span>
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="tm-pie marco">
      <div class="tm-pie__fila">
        <ul>
          {!inicio && <li><a href="/tinmarin/">Ruleta Tin Marín</a></li>}
          <li><a href="/tinmarin/privacidad/">Aviso de privacidad</a></li>
          <li><a href="/android/">Más apps para Android</a></li>
          <li><a href="/">Herramientas en gomflo.dev</a></li>
        </ul>
        <p>© {year} gomflo. Hecho en México.</p>
      </div>
    </footer>
  </body>
</html>
