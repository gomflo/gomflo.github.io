---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Ruta de la imagen para compartir (1200×630). */
  image?: string;
  imageAlt?: string;
  /** Para páginas que no deben aparecer en buscadores (404). */
  noindex?: boolean;
  /** Marca "Herramientas" en la navegación (páginas de herramienta). */
  section?: "herramientas";
}

const {
  title = "gomflo.dev",
  description = "Herramientas pequeñas para el día a día del desarrollo.",
  image,
  imageAlt,
  noindex = false,
  section,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const imageURL = image ? new URL(image, Astro.site).href : undefined;
const isHome = Astro.url.pathname === "/";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es-MX" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbf2e1" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/bricolage-grotesque-200_800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="gomflo.dev" />
    {imageURL && (
      <>
        <meta property="og:image" content={imageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt ?? title} />
      </>
    )}
    <!-- Twitter Card -->
    <meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <title>{title}</title>
    <slot name="head" />
    <!-- Antes de pintar: tema, y banderas de JS y movimiento para que nada parpadee.
         Astro reemplaza los atributos de <html> al navegar, así que se repite tras cada cambio. -->
    <script is:inline>
      (function () {
        function aplicar() {
          var h = document.documentElement;
          var stored = localStorage.getItem("theme");
          var isDark = stored === "dark" || (!stored && matchMedia("(prefers-color-scheme: dark)").matches);
          h.classList.toggle("dark", isDark);
          h.classList.add("js");
          h.classList.toggle("motion", !matchMedia("(prefers-reduced-motion: reduce)").matches);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", isDark ? "#131120" : "#fbf2e1");
        }
        aplicar();
        document.addEventListener("astro:after-swap", aplicar);
      })();
    </script>
    <!-- Visitas en un Umami propio, sin cookies. Sin query ni hash: lo que alguien
         escriba en una herramienta no debe viajar aunque un día acabe en la URL. -->
    <script
      is:inline
      defer
      src="https://stats.gomflo.dev/script.js"
      data-website-id="e7a2bcf5-7b1d-4aef-91a7-94458ce8530c"
      data-domains="gomflo.dev"
      data-exclude-search="true"
      data-exclude-hash="true"
      data-performance="true"></script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Ir al contenido principal</a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true"><span class="curtain__nombre titular" data-curtain-nombre></span></div>

    <header class="cabecera">
      <div class="contenedor cabecera__in">
        <a href="/" class="marca" aria-label="gomflo.dev, ir al inicio" aria-current={isHome ? "page" : undefined} data-destino="gomflo.dev">
          <span class="marca__piezas" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="marca__palabra titular">gomflo</span>
        </a>
        <nav class="cabecera__nav" aria-label="Principal">
          <a class="ficha" href="/#herramientas" aria-current={section === "herramientas" ? "true" : undefined} data-destino="Herramientas">Herramientas</a>
          <a class="ficha" href="/#apps" data-destino="Apps">Apps</a>
        </nav>
        <button type="button" class="tema" data-tema aria-label="Cambiar a modo oscuro">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <mask id="tema-mask">
              <rect width="24" height="24" fill="#fff"></rect>
              <circle class="tema__mordida" cx="25" cy="3" r="7" fill="#000"></circle>
            </mask>
            <circle class="tema__disco" cx="12" cy="12" r="5" fill="currentColor" mask="url(#tema-mask)"></circle>
            <g class="tema__rayos" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
              {[0, 45, 90, 135, 180, 225, 270, 315].map((deg) => (
                <path d="M12 2.5v2" transform={`rotate(${deg} 12 12)`} />
              ))}
            </g>
          </svg>
        </button>
      </div>
    </header>

    <slot />

    <footer class="remate contenedor">
      <div class="remate__bloque">
        <div class="remate__arriba">
          <p class="remate__regla titular">
            Sin cuenta, sin instalar nada, y lo que pegas no sale de tu navegador.
          </p>
          <nav class="remate__nav" aria-label="Pie de página">
            <ul role="list">
              <li><a class="ficha" href="/#herramientas" data-destino="Herramientas">Herramientas</a></li>
              <li><a class="ficha" href="/#apps" data-destino="Apps">Apps para Mac</a></li>
              <li><a class="ficha" href="/partidos-de-hoy/" data-astro-reload data-astro-prefetch="false">Partidos de hoy</a></li>
              <li><a class="ficha" href="https://github.com/gomflo" rel="noopener">GitHub</a></li>
            </ul>
          </nav>
        </div>
        <div class="remate__abajo">
          <p class="remate__nombre titular" aria-hidden="true">gomflo.dev</p>
          <span class="remate__piezas" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
        </div>
        <p class="remate__credito">
          © {year} Víctor Hugo Gómez Flores. Letra: Bricolage Grotesque y DM Mono.
        </p>
      </div>
    </footer>

    <slot name="after" />
    <script>
      import { start } from "../engine/astro";
      import { setupMotion } from "../motion/setup";
      start(setupMotion);
    </script>
  </body>
</html>

<style>
  .cabecera {
    position: relative;
    z-index: var(--z-header);
  }

  .cabecera__in {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1vw, 0.75rem);
    padding-block: clamp(0.75rem, 1.4vw, 1.125rem);
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    margin-right: auto;
    color: var(--tinta);
    text-decoration: none;
  }

  /* La marca: cuatro piezas en una caja de dos por dos. Al apuntarla se reacomodan. */
  .marca__piezas {
    display: grid;
    grid-template-columns: repeat(2, 0.75rem);
    gap: 0.1875rem;
  }
  .marca__piezas i,
  .remate__piezas i {
    display: block;
    aspect-ratio: 1;
    border-radius: 0.25rem;
    transition: translate 0.45s var(--ease-spring), border-radius 0.45s var(--ease-spring);
  }
  .marca__piezas i:nth-child(1) { background: var(--lila); }
  .marca__piezas i:nth-child(2) { background: var(--menta); }
  .marca__piezas i:nth-child(3) { background: var(--coral); }
  .marca__piezas i:nth-child(4) { background: var(--sol); }
  @media (hover: hover) {
    .marca:hover .marca__piezas i:nth-child(1) { translate: calc(100% + 0.1875rem) 0; }
    .marca:hover .marca__piezas i:nth-child(2) { translate: 0 calc(100% + 0.1875rem); }
    .marca:hover .marca__piezas i:nth-child(4) { translate: calc(-100% - 0.1875rem) 0; }
    .marca:hover .marca__piezas i:nth-child(3) { translate: 0 calc(-100% - 0.1875rem); }
  }

  .marca__palabra {
    font-size: 1.625rem;
    line-height: 1;
  }

  .cabecera__nav {
    display: flex;
    gap: 0.125rem;
    font-size: var(--t-s);
  }

  .tema {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 0.875rem;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease-soft),
      color 0.2s var(--ease-soft);
  }
  @media (hover: hover) {
    .tema:hover {
      background: var(--sol);
      color: var(--tinta-fija);
    }
  }
  .tema:active {
    background: var(--sol);
    color: var(--tinta-fija);
  }
  .tema svg {
    width: 24px;
    height: 24px;
    overflow: visible;
  }
  .tema__disco,
  .tema__mordida,
  .tema__rayos {
    transform-box: view-box;
    transform-origin: 12px 12px;
  }
  .tema__disco {
    transition: scale 0.5s var(--ease-spring);
  }
  .tema__mordida {
    transition: translate 0.5s var(--ease-out);
  }
  .tema__rayos {
    transition:
      rotate 0.5s var(--ease-out),
      scale 0.5s var(--ease-out),
      opacity 0.3s var(--ease-out);
  }
  @media (hover: hover) {
    .tema:hover .tema__rayos {
      rotate: 45deg;
    }
  }
  :global(.dark) .tema__disco {
    scale: 1.7;
  }
  :global(.dark) .tema__mordida {
    translate: -8px 4px;
  }
  :global(.dark) .tema__rayos {
    rotate: 90deg;
    scale: 0.4;
    opacity: 0;
  }

  /* ---------- Remate: el pie es el bloque más grande de la caja ---------- */

  .remate {
    margin-top: clamp(3.5rem, 8vw, 7rem);
    padding-bottom: var(--gutter);
  }

  .remate__bloque {
    --ficha: var(--crema-fija);
    --sobre-ficha: var(--tinta-fija);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    background: var(--bloque-oscuro);
    color: var(--crema-fija);
    border-radius: var(--radio-pieza);
  }

  .remate__bloque :global(:focus-visible) {
    outline-color: var(--sol);
  }

  .remate__arriba {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 2rem clamp(2rem, 8vw, 7rem);
    align-items: start;
  }

  .remate__regla {
    margin: 0;
    max-width: 22ch;
    font-size: var(--t-l);
    line-height: 1.02;
  }

  .remate__nav ul {
    display: grid;
    margin: 0 0 0 -0.9rem;
    padding: 0;
    list-style: none;
    justify-items: start;
  }

  .remate__abajo {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 7vw, 6rem);
  }

  .remate__nombre {
    margin: 0;
    font-size: clamp(3rem, 1rem + 11vw, 11rem);
    line-height: 0.8;
    letter-spacing: -0.02em;
    user-select: none;
  }

  .remate__piezas {
    display: flex;
    gap: 0.375rem;
    padding-bottom: 0.4rem;
  }
  .remate__piezas i {
    width: clamp(1.25rem, 2.4vw, 2.25rem);
    border-radius: 0.5rem;
  }
  .remate__piezas i:nth-child(1) { background: var(--menta); }
  .remate__piezas i:nth-child(2) { background: var(--coral); }
  .remate__piezas i:nth-child(3) { background: var(--lila); }
  .remate__piezas i:nth-child(4) { background: var(--sol); }
  .remate__piezas i:nth-child(5) { background: var(--cielo); }

  .remate__credito {
    margin: 1.75rem 0 0;
    color: #b5b0c8;
    font-size: var(--t-xs);
  }

  @media (max-width: 480px) {
    .cabecera__nav {
      font-size: var(--t-xs);
    }
    .cabecera__nav :global(.ficha) {
      padding-inline: 0.6rem;
    }
    .marca {
      gap: 0.45rem;
    }
    .marca__palabra {
      font-size: 1.375rem;
    }
  }

  @media (max-width: 800px) {
    .remate__arriba {
      grid-template-columns: minmax(0, 1fr);
    }
    .remate__nav ul {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
