---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { tools } from "../lib/tools";

interface Props {
  title?: string;
  description?: string;
  /** Ruta de la imagen para compartir (1200×630). */
  image?: string;
  imageAlt?: string;
  /** Para páginas que no deben aparecer en buscadores (404). */
  noindex?: boolean;
  /** Marca "Herramientas" en la navegación (páginas de herramienta). */
  section?: "herramientas";
}

const {
  title = "gomflo.dev",
  description = "Herramientas pequeñas para el día a día del desarrollo.",
  image,
  imageAlt,
  noindex = false,
  section,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const imageURL = image ? new URL(image, Astro.site).href : undefined;
const isHome = Astro.url.pathname === "/";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es-MX" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbf2e1" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/bricolage-grotesque-200_800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="gomflo.dev" />
    {imageURL && (
      <>
        <meta property="og:image" content={imageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt ?? title} />
      </>
    )}
    <!-- Twitter Card -->
    <meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <title>{title}</title>
    <slot name="head" />
    <!-- Antes de pintar: tema, y banderas de JS y movimiento para que nada parpadee.
         Astro reemplaza los atributos de <html> al navegar, así que se repite tras cada cambio. -->
    <script is:inline>
      (function () {
        function aplicar() {
          var h = document.documentElement;
          var stored = localStorage.getItem("theme");
          var isDark = stored === "dark" || (!stored && matchMedia("(prefers-color-scheme: dark)").matches);
          h.classList.toggle("dark", isDark);
          h.classList.add("js");
          h.classList.toggle("motion", !matchMedia("(prefers-reduced-motion: reduce)").matches);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", isDark ? "#131120" : "#fbf2e1");
        }
        aplicar();
        document.addEventListener("astro:after-swap", aplicar);
      })();
    </script>
    <!-- Visitas en un Umami propio, sin cookies. Sin query ni hash: lo que alguien
         escriba en una herramienta no debe viajar aunque un día acabe en la URL. -->
    <script
      is:inline
      defer
      src="https://stats.gomflo.dev/script.js"
      data-website-id="e7a2bcf5-7b1d-4aef-91a7-94458ce8530c"
      data-domains="gomflo.dev"
      data-exclude-search="true"
      data-exclude-hash="true"
      data-performance="true"></script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Ir al contenido principal</a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true"><span class="curtain__nombre titular" data-curtain-nombre></span></div>

    <header class="cabecera">
      <div class="contenedor cabecera__in">
        <a href="/" class="marca" aria-label="gomflo.dev, ir al inicio" aria-current={isHome ? "page" : undefined} data-destino="gomflo.dev">
          <span class="marca__piezas" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="marca__palabra titular">gomflo</span>
        </a>
        <nav class="cabecera__nav" aria-label="Principal">
          <a class="ficha" href="/#herramientas" aria-current={section === "herramientas" ? "true" : undefined} data-destino="Herramientas">Herramientas</a>
          <a class="ficha" href="/#apps" data-destino="Apps">Apps</a>
        </nav>
        <button type="button" class="tema" data-tema aria-label="Cambiar a modo oscuro">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <mask id="tema-mask">
              <rect width="24" height="24" fill="#fff"></rect>
              <circle class="tema__mordida" cx="25" cy="3" r="7" fill="#000"></circle>
            </mask>
            <circle class="tema__disco" cx="12" cy="12" r="5" fill="currentColor" mask="url(#tema-mask)"></circle>
            <g class="tema__rayos" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
              {[0, 45, 90, 135, 180, 225, 270, 315].map((deg) => (
                <path d="M12 2.5v2" transform={`rotate(${deg} 12 12)`} />
              ))}
            </g>
          </svg>
        </button>
      </div>
    </header>

    <slot />

    <!-- El pie: las dos últimas filas de la caja, en mosaicos llenos. -->
    <footer class="remate">
      <div class="remate__tablero">
        <div class="loseta loseta--regla">
          <p class="remate__regla">Sin cuenta, sin instalar nada, y lo que pegas no sale de tu navegador.</p>
          <p class="remate__credito">© {year} Víctor Hugo Gómez Flores. Letra: Bricolage Grotesque y DM Mono.{/* taste-skill-ignore: nombra la letra, no la usa */}</p>
        </div>
        <nav class="loseta loseta--nav" aria-label="Pie de página">
          <ul role="list">
            <li><a href="/#herramientas" data-destino="Herramientas">Herramientas</a></li>
            <li><a href="/#apps" data-destino="Apps">Apps para Mac</a></li>
            <li><a href="/android/" data-astro-reload data-astro-prefetch="false">Apps para Android</a></li>
            <li><a href="/partidos-de-hoy/" data-astro-reload data-astro-prefetch="false">Partidos de hoy</a></li>
            <li><a href="#main-content">Volver arriba</a></li>
          </ul>
        </nav>
        <div class="loseta loseta--lugar">
          <p>Hecho en México.</p>
          <p class="remate__suave">CLABE, IVA y feriados con las reglas de aquí.</p>
        </div>
        <a class="loseta loseta--codigo" href="https://github.com/gomflo" rel="noopener">
          <span class="remate__suave">El código, abierto</span>
          <span class="remate__direccion">github.com/gomflo</span>
        </a>
        <a class="loseta loseta--marca" href="/" aria-label="gomflo.dev, ir al inicio" data-destino="gomflo.dev">
          <span class="remate__marca titular" aria-hidden="true">gomflo</span>
        </a>
        <a class="loseta loseta--accion" href="/#herramientas" data-destino="Herramientas">
          <span class="remate__invita">Ver las {tools.length} piezas</span>
          <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M12 36L36 12M16 12h20v20" /></svg>
        </a>
      </div>
    </footer>

    <slot name="after" />
    <script>
      import { start } from "../engine/astro";
      import { setupMotion } from "../motion/setup";
      start(setupMotion);
    </script>
  </body>
</html>

<style>
  .cabecera {
    position: relative;
    z-index: var(--z-header);
  }

  .cabecera__in {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1vw, 0.75rem);
    padding-block: clamp(0.75rem, 1.4vw, 1.125rem);
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    margin-right: auto;
    color: var(--tinta);
    text-decoration: none;
  }

  /* La marca: cuatro piezas en una caja de dos por dos. Al apuntarla se reacomodan. */
  .marca__piezas {
    display: grid;
    grid-template-columns: repeat(2, 0.75rem);
    gap: 0.1875rem;
  }
  .marca__piezas i {
    display: block;
    aspect-ratio: 1;
    border-radius: 0.25rem;
    transition: translate 0.45s var(--ease-spring), border-radius 0.45s var(--ease-spring);
  }
  .marca__piezas i:nth-child(1) { background: var(--lila); }
  .marca__piezas i:nth-child(2) { background: var(--menta); }
  .marca__piezas i:nth-child(3) { background: var(--coral); }
  .marca__piezas i:nth-child(4) { background: var(--sol); }
  @media (hover: hover) {
    .marca:hover .marca__piezas i:nth-child(1) { translate: calc(100% + 0.1875rem) 0; }
    .marca:hover .marca__piezas i:nth-child(2) { translate: 0 calc(100% + 0.1875rem); }
    .marca:hover .marca__piezas i:nth-child(4) { translate: calc(-100% - 0.1875rem) 0; }
    .marca:hover .marca__piezas i:nth-child(3) { translate: 0 calc(-100% - 0.1875rem); }
  }

  .marca__palabra {
    font-size: 1.625rem;
    line-height: 1;
  }

  .cabecera__nav {
    display: flex;
    gap: 0.125rem;
    font-size: var(--t-s);
  }

  .tema {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 0.875rem;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease-soft),
      color 0.2s var(--ease-soft);
  }
  @media (hover: hover) {
    .tema:hover {
      background: var(--sol);
      color: var(--tinta-fija);
    }
  }
  .tema:active {
    background: var(--sol);
    color: var(--tinta-fija);
  }
  .tema svg {
    width: 24px;
    height: 24px;
    overflow: visible;
  }
  .tema__disco,
  .tema__mordida,
  .tema__rayos {
    transform-box: view-box;
    transform-origin: 12px 12px;
  }
  .tema__disco {
    transition: scale 0.5s var(--ease-spring);
  }
  .tema__mordida {
    transition: translate 0.5s var(--ease-out);
  }
  .tema__rayos {
    transition:
      rotate 0.5s var(--ease-out),
      scale 0.5s var(--ease-out),
      opacity 0.3s var(--ease-out);
  }
  @media (hover: hover) {
    .tema:hover .tema__rayos {
      rotate: 45deg;
    }
  }
  :global(.dark) .tema__disco {
    scale: 1.7;
  }
  :global(.dark) .tema__mordida {
    translate: -8px 4px;
  }
  :global(.dark) .tema__rayos {
    rotate: 90deg;
    scale: 0.4;
    opacity: 0;
  }

  /* ---------- Remate: un tablero de mosaicos llenos, separados por 8 px ---------- */

  .remate {
    margin-top: clamp(5rem, 11vw, 10rem);
    padding: 0.625rem;
  }

  .remate__tablero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(clamp(10rem, 15vw, 13.75rem), auto);
    gap: 0.5rem;
  }

  .loseta {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    min-width: 0;
    padding: clamp(1.125rem, 0.8rem + 1vw, 1.5rem);
    background: var(--crema-honda);
    color: var(--tinta);
    text-decoration: none;
    border-radius: var(--radio-sobrio);
  }
  .loseta p {
    margin: 0;
  }

  .loseta--regla { grid-column: 1 / 5; }
  .loseta--nav { grid-column: 5 / 8; justify-content: flex-start; }
  .loseta--lugar { grid-column: 8 / 10; justify-content: flex-start; gap: 0.5rem; }
  .loseta--codigo { grid-column: 10 / 13; }
  .loseta--marca { grid-column: 1 / 9; }
  .loseta--accion { grid-column: 9 / 13; }

  .remate__regla {
    max-width: 24ch;
    font-size: var(--t-destacado);
    font-weight: 600;
    line-height: 1.3;
  }

  .remate__credito,
  .remate__suave {
    color: var(--gris);
    font-size: var(--t-chico);
    line-height: 1.45;
  }

  .loseta--nav ul {
    display: grid;
    gap: 0.125rem;
    margin: -0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .loseta--nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: inherit;
    font-size: var(--t-texto);
    text-decoration: none;
    text-underline-offset: 0.2em;
  }
  @media (hover: hover) {
    .loseta--nav a:hover {
      text-decoration: underline;
      text-decoration-thickness: 2px;
    }
  }

  .loseta--lugar p:first-child {
    font-size: var(--t-texto);
    font-weight: 600;
  }

  .remate__direccion {
    font-size: var(--t-destacado);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  /* Los dos mosaicos de abajo: la marca en tinta y la invitación en color sol. */
  .loseta--marca,
  .loseta--accion {
    min-height: clamp(10rem, 22vw, 20rem);
    transition:
      background-color 0.2s var(--ease-soft),
      scale 0.2s var(--ease-soft);
  }
  .loseta--marca {
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--tinta);
    color: var(--crema);
  }
  .remate__marca {
    font-size: clamp(3.5rem, 9.5vw, 9rem);
    line-height: 1;
    letter-spacing: -0.03em;
    transition: translate 0.5s var(--ease-out);
  }
  @media (hover: hover) {
    .loseta--marca:hover .remate__marca {
      translate: 0 -0.08em;
    }
  }

  .loseta--accion {
    background: var(--sol);
    color: var(--tinta-fija);
  }
  .remate__invita {
    font-size: var(--t-destacado);
    font-weight: 600;
  }
  .loseta--accion svg {
    align-self: flex-end;
    width: clamp(2.5rem, 4vw, 3.5rem);
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.35s var(--ease-out);
  }
  @media (hover: hover) {
    .loseta--accion:hover svg {
      translate: 0.25rem -0.25rem;
    }
    .loseta--codigo:hover {
      background: var(--linea);
    }
  }
  .loseta--marca:active,
  .loseta--accion:active,
  .loseta--codigo:active {
    scale: 0.985;
  }

  @media (max-width: 480px) {
    .cabecera__nav {
      font-size: var(--t-xs);
    }
    .cabecera__nav :global(.ficha) {
      padding-inline: 0.6rem;
    }
    .marca {
      gap: 0.45rem;
    }
    .marca__palabra {
      font-size: 1.375rem;
    }
  }

  /* En el teléfono: dos columnas; primero la marca y la invitación, a todo lo ancho. */
  @media (max-width: 800px) {
    .remate__tablero {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
      gap: 0.375rem;
    }
    .loseta {
      padding: 1.25rem;
    }
    .loseta--marca { grid-column: 1 / -1; grid-row: 1; min-height: 10rem; }
    .loseta--accion { grid-column: 1 / -1; grid-row: 2; min-height: 8rem; }
    .loseta--nav { grid-column: 1; grid-row: 3; }
    .loseta--codigo { grid-column: 2; grid-row: 3; }
    .loseta--lugar { grid-column: 1; grid-row: 4; }
    .loseta--regla { grid-column: 2; grid-row: 4; }
    .remate__marca {
      font-size: 22vw;
    }
  }
</style>
