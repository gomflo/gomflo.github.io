---
import ToolLayout from "../layouts/ToolLayout.astro";
import UserAgentView from "../components/UserAgent";

const faq = [
  { q: "¿Qué es el User Agent?", a: "Es un texto que el navegador envía en cada petición para identificar su nombre, versión y sistema operativo. Los sitios lo usan para estadísticas y para resolver problemas de compatibilidad." },
  { q: "¿Para qué necesito saber mi User Agent?", a: "Para reportar un error a soporte técnico, reproducir un problema en otro navegador o configurar reglas en un servidor o firewall." },
  { q: "¿Por qué casi todos los User Agent empiezan con Mozilla/5.0?", a: "Por compatibilidad histórica: en los noventa muchos sitios solo servían su versión moderna a Netscape, cuyo nombre interno era Mozilla. Los demás navegadores empezaron a imitarlo y la costumbre se quedó." },
];
---

<ToolLayout
  slug="user-agent"
  metaTitle={"Mi User Agent: ¿cuál es mi agente de usuario? | gomflo.dev"}
  description={"Mira cuál es tu User Agent (agente de usuario): la cadena con la que tu navegador y sistema operativo se identifican. Cópiala para soporte o pruebas."}
  heading={"¿Cuál es mi User Agent?"}
  lead={"Consulta el User Agent que envía tu navegador en cada petición web."}
  sectionLabel={"User Agent del navegador"}
  faq={faq}
>
  <UserAgentView client:load />
</ToolLayout>
