---
import ToolLayout from "../layouts/ToolLayout.astro";
import Base64FileConverter from "../components/Base64FileConverter";

const faq = [
  { q: "¿Para qué convierto un archivo a Base64?", a: "Para incrustarlo como texto: imágenes en HTML o CSS con una URL data:, adjuntos dentro de un JSON o archivos en variables de entorno." },
  { q: "¿Cuánto crece un archivo al pasarlo a Base64?", a: "Alrededor de un 33 %: cada 3 bytes se convierten en 4 caracteres. Por eso no conviene incrustar imágenes grandes en HTML o CSS." },
  { q: "¿Cómo recupero el archivo desde Base64?", a: "Pega la cadena o la URL data: en Base64 a Archivo y descárgalo. Si la cadena incluye el tipo MIME, se sugiere la extensión correcta." },
];
---

<ToolLayout
  slug="base64-archivo"
  metaTitle={"Convertir archivo a Base64 y Base64 a archivo | gomflo.dev"}
  description={"Convierte imágenes, PDF o cualquier archivo a Base64 (data URL) y descarga un archivo a partir de una cadena Base64. Nada se sube a un servidor."}
  heading={"Base64 ↔ Archivo"}
  lead={"Convierte archivos a Base64 o pega Base64 para descargar el archivo."}
  sectionLabel={"Conversor Base64 y archivo"}
  faq={faq}
>
  <Base64FileConverter client:load />
</ToolLayout>
