---
import ToolLayout from "../layouts/ToolLayout.astro";
import JwtDecoder from "../components/JwtDecoder";

const faq = [
  { q: "¿Qué es un JWT?", a: "Un JSON Web Token es una cadena de tres partes separadas por puntos: header, payload y firma. Las dos primeras son JSON codificado en Base64URL. Se usa sobre todo para autenticar peticiones a APIs." },
  { q: "¿Decodificar un JWT es lo mismo que verificarlo?", a: "No. Decodificar solo lee el contenido, que no está cifrado. Verificar comprueba la firma con la llave secreta o pública del emisor, y eso debe hacerse en tu servidor." },
  { q: "¿Es seguro pegar mi token aquí?", a: "El token se decodifica en tu navegador y no se envía a ningún lado. Aun así, trata los tokens de producción como si fueran contraseñas." },
];
---

<ToolLayout
  slug="decodificar-jwt"
  metaTitle={"Decodificar JWT online (JWT decoder) | gomflo.dev"}
  description={"Decodifica un JWT y ve su header y payload en JSON legible, con claims como exp, iat y sub. El token se procesa en tu navegador y no se envía a ningún lado."}
  heading={"Decodificar JWT"}
  lead={"Pega un JWT y obtén el header y el payload decodificados en JSON."}
  sectionLabel={"Decodificador JWT"}
  faq={faq}
>
  <JwtDecoder client:load />
</ToolLayout>
