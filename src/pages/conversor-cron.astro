---
import ToolLayout from "../layouts/ToolLayout.astro";
import CronConverter from "../components/CronConverter";

const faq = [
  { q: "¿Qué es una expresión cron?", a: "Es una cadena de cinco campos (minuto, hora, día del mes, mes y día de la semana) que indica cuándo se ejecuta una tarea programada en Linux, Kubernetes, GitHub Actions y muchos otros sistemas." },
  { q: "¿Qué significa */5 en una expresión cron?", a: "Significa cada 5. En el campo de minutos, */5 ejecuta la tarea cada cinco minutos: en el minuto 0, 5, 10 y así sucesivamente." },
  { q: "¿En qué zona horaria se ejecuta un cron?", a: "Depende del sistema. El cron de Linux usa la hora del servidor; GitHub Actions y muchos servicios en la nube usan UTC, así que conviene convertir la hora antes de programar." },
];
---

<ToolLayout
  slug="conversor-cron"
  metaTitle={"Expresiones cron explicadas en español | gomflo.dev"}
  description={"Genera expresiones cron (ej. 0 0 * * *) con el constructor visual y traduce cualquier cron a lenguaje natural en español. Sin registro, gratis."}
  heading={"Conversor de Cron"}
  lead={"Genera expresiones cron y descubre en lenguaje natural cuándo se ejecutarán: cada hora, todos los días a las 9:00, de lunes a viernes."}
  sectionLabel={"Constructor y explicador de expresiones Cron"}
  faq={faq}
>
  <CronConverter client:load />
</ToolLayout>
