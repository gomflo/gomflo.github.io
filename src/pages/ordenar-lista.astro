---
import ToolLayout from "../layouts/ToolLayout.astro";
import ListSorter from "../components/ListSorter";

const faq = [
  { q: "¿Cómo ordeno una lista alfabéticamente?", a: "Pega la lista con un elemento por línea y elige A–Z o Z–A. El resultado se actualiza al instante y puedes copiarlo con un clic." },
  { q: "¿Dónde queda la ñ y las palabras con acento?", a: "Se ordenan con las reglas del español: la ñ va después de la n, y las palabras con acento quedan junto a su versión sin acento, no al final de la lista." },
  { q: "¿Puedo ordenar una columna de Excel?", a: "Sí. Copia la columna, pégala aquí y copia el resultado de vuelta: cada celda queda en su propia línea." },
];
---

<ToolLayout
  slug="ordenar-lista"
  metaTitle={"Ordenar lista alfabéticamente online | gomflo.dev"}
  description={"Ordena alfabéticamente una lista de palabras o líneas, de la A a la Z o de la Z a la A, con las reglas del español para acentos y la ñ."}
  heading={"Ordenar lista"}
  lead={"Ordena una lista de texto alfabéticamente, de la A a la Z o al revés. Un elemento por línea."}
  sectionLabel={"Ordenador de lista"}
  faq={faq}
>
  <ListSorter client:load />
</ToolLayout>
