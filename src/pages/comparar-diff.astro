---
import ToolLayout from "../layouts/ToolLayout.astro";
import DiffViewer from "../components/DiffViewer";

const faq = [
  { q: "¿Cómo comparo dos textos?", a: "Pega la versión original en el primer campo y la nueva en el segundo. Las líneas agregadas se marcan en verde y las eliminadas en rojo." },
  { q: "¿Puedo comparar dos JSON?", a: "Sí. Para que la comparación sea útil, formatea ambos JSON antes con la misma sangría; así cada cambio aparece en su propia línea." },
  { q: "¿Los textos se envían a un servidor?", a: "No. La comparación se hace en tu navegador, así que puedes comparar configuraciones o datos privados." },
];
---

<ToolLayout
  slug="comparar-diff"
  metaTitle={"Comparar texto o JSON (Diff) | gomflo.dev"}
  description={"Compara dos bloques de texto o JSON y visualiza las diferencias línea por línea. Herramienta de diff online para ver cambios entre versiones."}
  heading={"Comparar texto (Diff)"}
  lead={"Pega dos bloques de texto o JSON y revisa las diferencias línea por línea. Sirve para configuraciones, respuestas de API o cualquier texto."}
  sectionLabel={"Comparador de diferencias"}
  faq={faq}
>
  <DiffViewer client:load />
</ToolLayout>
