---
import ToolLayout from "../layouts/ToolLayout.astro";
import AccentRemover from "../components/AccentRemover";

const faq = [
  { q: "¿Para qué sirve quitar los acentos?", a: "Para generar URLs, nombres de archivo, usuarios o claves que deben usar solo caracteres ASCII, y para comparar o buscar textos sin importar las tildes." },
  { q: "¿También quita la ñ?", a: "Sí, la ñ pasa a n porque su virgulilla es un diacrítico. Si necesitas conservarla, revísala en el resultado." },
  { q: "¿Cambia las mayúsculas o los signos de puntuación?", a: "No. Solo quita las marcas sobre las letras; mayúsculas, números, espacios y signos como ¿ y ¡ se conservan." },
];
---

<ToolLayout
  slug="remover-acentos"
  metaTitle={"Quitar acentos y tildes de un texto online | gomflo.dev"}
  description={"Quita acentos, tildes, diéresis y otros diacríticos de un texto: convierte á en a, ü en u y ç en c. Útil para URLs, nombres de archivo y bases de datos."}
  heading={"Remover acentos"}
  lead={"Quita acentos, tildes y diacríticos del texto en tiempo real."}
  sectionLabel={"Removedor de acentos"}
  faq={faq}
>
  <AccentRemover client:load />
</ToolLayout>
