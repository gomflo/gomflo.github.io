---
import ToolLayout from "../layouts/ToolLayout.astro";
import CharacterCounter from "../components/CharacterCounter";

const faq = [
  { q: "¿Los espacios cuentan como caracteres?", a: "Depende de la plataforma, por eso se muestran los dos totales: con espacios y sin espacios. X (Twitter), Instagram y los SMS cuentan los espacios; algunos formularios y concursos piden el total sin espacios." },
  { q: "¿Cuántos caracteres debe tener una meta description?", a: "Google suele mostrar entre 150 y 160 caracteres. Para el título de una página, lo recomendable es quedarse por debajo de 60." },
  { q: "¿Un emoji cuenta como uno o dos caracteres?", a: "Aquí cuenta como uno, igual que lo ves. Algunos sistemas antiguos lo cuentan como dos porque internamente ocupa dos unidades de código; X, por ejemplo, cuenta cada emoji como dos caracteres de sus 280." },
];
---

<ToolLayout
  slug="contar-caracteres"
  metaTitle={"Contador de caracteres y palabras online | gomflo.dev"}
  description={"Cuenta caracteres con y sin espacios, palabras y líneas al instante, y compáralos con los límites de X, Instagram, SMS y meta descriptions. Sin registro."}
  heading={"Contador de caracteres"}
  lead={"Cuenta caracteres con y sin espacios, palabras y líneas mientras escribes, y revisa si cabes en cada plataforma."}
  sectionLabel={"Contador de caracteres"}
  faq={faq}
>
  <CharacterCounter client:load />
</ToolLayout>
