---
import ToolLayout from "../layouts/ToolLayout.astro";
import JsonFormatter from "../components/JsonFormatter";

const faq = [
  { q: "¿Qué hace formatear un JSON?", a: "Agrega saltos de línea y sangría de dos espacios para que la estructura se lea de un vistazo. Minificar hace lo contrario: quita los espacios para que ocupe menos al enviarlo o guardarlo." },
  { q: "¿Por qué me dice que mi JSON es inválido?", a: "Los errores más comunes son comillas simples en lugar de dobles, una coma después del último elemento y claves sin comillas. El mensaje de error indica la posición aproximada del problema." },
  { q: "¿Mi JSON se envía a algún servidor?", a: "No. Se procesa en tu navegador, así que puedes formatear respuestas de API con datos sensibles." },
];
---

<ToolLayout
  slug="formatear-json"
  metaTitle={"Formatear JSON online (JSON formatter) | gomflo.dev"}
  description={"Formatea JSON con sangría para leerlo fácil o minifícalo en una sola línea. Detecta errores de sintaxis y funciona en tu navegador, sin enviar tus datos."}
  heading={"Formatear JSON"}
  lead={"Pega JSON sin formato y obtén una versión legible o minificada."}
  sectionLabel={"Formateador"}
  faq={faq}
>
  <JsonFormatter client:load />
</ToolLayout>
