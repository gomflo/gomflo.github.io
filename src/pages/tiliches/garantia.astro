<script>
  import { SELLOS, calcular, cuantoQueda, fechaLarga, leerEntero, leerFecha, sello, type Plazo } from "@/lib/garantia";

  const nMeses = (n: number) => `${n} ${n === 1 ? "mes" : "meses"}`;
  const nDias = (n: number) => `${n} ${n === 1 ? "día" : "días"}`;

  /** Hoy según el reloj del dispositivo, en su huso. */
  const hoyLocal = () => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  };

  function iniciar() {
    const raiz = document.querySelector<HTMLElement>("[data-garantia]");
    const form = raiz?.querySelector<HTMLFormElement>("[data-gt-form]");
    if (!raiz || !form) return;
    const salida = (k: string) => raiz.querySelector<HTMLElement>(`[data-salida="${k}"]`)!;
    const campo = (name: string) => form.querySelector<HTMLInputElement>(`[name="${name}"]`)!;
    const error = (k: string) => raiz.querySelector<HTMLElement>(`[data-error="${k}"]`)!;
    const otro = raiz.querySelector<HTMLElement>("[data-otro]")!;
    let contado = false;

    const pintar = (clave: "garantia" | "devolucion", p: Plazo | null, aviso: number, titulo: string, nota: string, meses = 0) => {
      const tarjeta = raiz.querySelector<HTMLElement>(`[data-plazo="${clave}"]`)!;
      salida(`${clave}-titulo`).textContent = titulo;
      salida(`${clave}-nota`).textContent = nota;
      tarjeta.hidden = false;
      if (!p) {
        tarjeta.dataset.sello = "sin";
        salida(`${clave}-sello`).textContent = "No aplica";
        salida(`${clave}-fecha`).textContent = clave === "garantia" ? "Sin garantía escrita" : "Sin plazo para devolver";
        salida(`${clave}-queda`).textContent = "";
        return;
      }
      const s = sello(p, aviso);
      tarjeta.dataset.sello = s;
      salida(`${clave}-sello`).textContent = SELLOS[s];
      salida(`${clave}-fecha`).textContent = `${p.vencido ? "Último día:" : "Hasta el"} ${fechaLarga(p.fin)}`;
      salida(`${clave}-queda`).textContent = cuantoQueda(p, meses);
    };

    const recalcular = () => {
      const eleccion = form.querySelector<HTMLInputElement>('[name="meses"]:checked')?.value ?? "12";
      otro.hidden = eleccion !== "otro";
      const meses = eleccion === "otro" ? leerEntero(campo("meses-otro").value) : Number(eleccion);
      const hoy = hoyLocal();
      const entrada = { compra: campo("compra").value, meses, dias: leerEntero(campo("dias").value), hoy };
      const r = calcular(entrada);
      salida("hoy").textContent = fechaLarga(leerFecha(hoy)!);

      // Cada campo marca su propio error, aunque haya otro antes.
      const malos = {
        compra: leerFecha(entrada.compra) === null,
        meses: calcular({ ...entrada, compra: "2000-01-01" }) === "meses",
        dias: calcular({ ...entrada, compra: "2000-01-01", meses: 0 }) === "dias",
      };
      for (const [k, malo] of Object.entries(malos)) {
        error(k).hidden = !malo;
        const input = k === "meses" ? campo("meses-otro") : campo(k);
        input.toggleAttribute("aria-invalid", malo);
      }

      const sinFecha = salida("sin-fecha");
      const minimo = salida("minimo");
      if (typeof r === "string") {
        // Con un campo mal escrito no se muestra un resultado a medias.
        for (const t of raiz.querySelectorAll<HTMLElement>("[data-plazo]")) t.hidden = true;
        minimo.hidden = true;
        sinFecha.hidden = false;
        sinFecha.textContent =
          r === "compra" ? "Escribe la fecha de compra o de entrega para ver los plazos." : "Revisa el campo marcado para ver los plazos.";
        return;
      }
      sinFecha.hidden = true;
      pintar(
        "devolucion",
        r.devolucion,
        7,
        "Para devolver",
        r.dias > 0 ? `${nDias(r.dias)}, según la política de la tienda.` : "La tienda no acepta devoluciones, o no lo anotaste.",
      );
      pintar(
        "garantia",
        r.garantia,
        30,
        r.meses > 0 ? `Garantía de ${nMeses(r.meses)}` : "Garantía",
        r.meses > 0 ? "Ese día incluido." : "Revisa si el producto trae póliza: ahí dice cuánto dura.",
        r.mesesQuedan,
      );
      const fin90 = fechaLarga(r.minimoLegal.fin);
      if (r.menorAlMinimo || !r.garantia) {
        minimo.hidden = false;
        minimo.textContent = r.garantia
          ? `Ojo: si te la ofrecieron como garantía, la ley pide que dure al menos 90 días desde la entrega, es decir, hasta el ${fin90}.`
          : `Si te ofrecieron garantía, la ley pide que dure al menos 90 días desde la entrega: hasta el ${fin90}.`;
      } else minimo.hidden = true;
    };

    const contar = () => {
      // Una visita que usa la calculadora cuenta una vez; no viaja nada de lo que se escribe.
      if (contado) return;
      contado = true;
      (window as { umami?: { track: (e: string) => void } }).umami?.track("garantia-calcula");
    };

    form.addEventListener("input", () => {
      recalcular();
      contar();
    });
    form.addEventListener("change", recalcular);
    form.addEventListener("submit", (e) => e.preventDefault());
    // La página sale con la fecha del despliegue: aquí se pone la de hoy (y lo que el navegador haya restaurado).
    recalcular();
  }

  // Con ClientRouter los scripts del bundle corren una vez: astro:page-load corre en cada visita.
  document.addEventListener("astro:page-load", iniciar);
</script>

