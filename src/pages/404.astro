---
import Layout from "../layouts/Layout.astro";
import Piezas from "../components/Piezas.astro";
---

<Layout title="Página no encontrada | gomflo.dev" description="Esta página no existe o cambió de dirección. Elige una de las herramientas." noindex>
  <main id="main-content" class="perdida contenedor" tabindex="-1">
    <section class="perdida__arriba" aria-labelledby="perdida-titulo">
      <div class="pieza perdida__titulo entra" data-cabeza>
        <p class="etiqueta">error 404</p>
        <h1 id="perdida-titulo" class="titular">Esta pieza <span>no está en la caja.</span></h1>
      </div>
      <div class="perdida__nota entra">
        <p>La dirección no existe o cambió de lugar. Lo que sí hay está aquí abajo, y ya está funcionando.</p>
        <a class="perdida__boton" href="/" data-destino="Inicio">Ir al inicio</a>
      </div>
    </section>

    <section class="perdida__lista" aria-label="Todas las herramientas">
      <Piezas level={2} />
    </section>
  </main>
</Layout>

<style>
  .perdida__lista {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .perdida__arriba {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--hueco);
    margin-bottom: var(--hueco);
  }

  .perdida__titulo {
    --pieza: var(--bloque-oscuro);
    justify-content: space-between;
    gap: 2.5rem;
    min-height: clamp(14rem, 30vw, 20rem);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    color: var(--crema-fija);
  }
  .perdida__titulo .etiqueta {
    margin: 0;
  }
  .perdida h1 {
    margin: 0;
    font-size: var(--t-xl);
  }
  .perdida h1 span {
    color: var(--coral);
  }

  .perdida__nota {
    --d: 0.08s;
    --de: 1.5deg;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    background: var(--coral);
    color: var(--tinta-fija);
    border-radius: var(--radio-pieza);
  }
  .perdida__nota p {
    margin: 0;
    font-size: var(--t-m);
    font-weight: 600;
    line-height: 1.25;
  }

  .perdida__boton {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.4rem;
    background: var(--tinta-fija);
    color: var(--crema-fija);
    font-weight: 700;
    text-decoration: none;
    border-radius: 0.875rem;
    transition:
      background-color 0.2s var(--ease-soft),
      color 0.2s var(--ease-soft),
      scale 0.2s var(--ease-soft);
  }
  @media (hover: hover) {
    .perdida__boton:hover {
      background: #ffffff;
      color: var(--tinta-fija);
    }
  }
  .perdida__boton:active {
    scale: 0.96;
  }
  .perdida__boton:focus-visible {
    outline-color: var(--tinta-fija);
  }

  @media (max-width: 800px) {
    .perdida__arriba {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
