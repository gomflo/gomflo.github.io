---
import Layout from "../layouts/Layout.astro";
import Piezas from "../components/Piezas.astro";
import { tools } from "../lib/tools";
import { androidApps } from "../data/android-apps";

// Apps de escritorio: sus landings se publican desde otros repos (ver astro.config.mjs).
// Sin `href` la app sale como "Muy pronto" y no enlaza a nada.
const apps: { slug: string; title: string; desc: string; href?: string }[] = [
  {
    slug: "susurro",
    title: "Susurro",
    desc: "Dictado por voz. Mantén fn, habla y suelta: el texto aparece pulido en cualquier app, sin salir de tu equipo.",
    href: "/susurro/",
  },
  {
    slug: "destello",
    title: "Destello",
    desc: "Capturas de pantalla. Captura, anota, copia texto, fija y graba con un atajo; nativa y sin nube.",
    href: "/destello/",
  },
  {
    slug: "brinco",
    title: "Brinco",
    desc: "Cambio de escritorio al instante. Brinca entre Spaces con tus atajos o el trackpad, sin la animación de macOS.",
    href: "/brinco/",
  },
];

const siteURL = new URL("/", Astro.site).href;
const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "gomflo.dev",
    url: siteURL,
    inLanguage: "es-MX",
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Herramientas online gratis",
    itemListElement: tools.map((tool, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: tool.title,
      url: new URL(tool.href, Astro.site).href,
    })),
  },
]).replace(/</g, "\\u003c");
---

<Layout
  title="gomflo.dev | Herramientas online gratis en español"
  image="/img/inicio.jpeg"
  imageAlt="gomflo.dev: herramientas online gratis en español"
  description="Herramientas online gratis en español: validar CLABE, calculadora de IVA, días hábiles, números a letras, romanos, código morse, JSON, contraseñas y más."
>
  <main id="main-content" class="inicio contenedor" tabindex="-1">
    <!-- Portada: el título y la mesa de pruebas. Lo que se escribe en la mesa pasa por todas las piezas. -->
    <section class="portada" aria-labelledby="portada-titulo">
      <div class="pieza portada__titulo entra" data-cabeza>
        <p class="etiqueta">{tools.length} piezas · gratis · en español</p>
        <h1 id="portada-titulo" class="titular">Herramientas online gratis <span>para el día a día.</span></h1>
      </div>
      <div class="mesa entra">
        <label for="muestra" class="etiqueta">la mesa de pruebas</label>
        <textarea id="muestra" data-muestra rows="2" maxlength="160" spellcheck="false" autocomplete="off">¡Hola, México!</textarea>
        <p class="mesa__nota">
          Escribe lo que quieras aquí arriba. Las {tools.length} piezas de abajo ya lo están trabajando.
        </p>
      </div>
      <ul class="reglas" role="list">
        <li class="entra">Sin cuenta</li>
        <li class="entra">Sin instalar</li>
        <li class="entra">Nada sale de tu navegador</li>
      </ul>
    </section>

    <!-- La caja de piezas, con su buscador. -->
    <section id="herramientas" class="caja" aria-labelledby="caja-titulo">
      <div class="buscador" data-buscador-barra>
        <h2 id="caja-titulo" class="titular">Todas las piezas</h2>
        <div class="buscador__campo">
          <label for="buscador" class="sr-only">Buscar herramienta</label>
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="8.5" cy="8.5" r="5.5" /><path d="M13 13l4.5 4.5" /></svg>
          <input
            id="buscador"
            type="search"
            data-buscador
            placeholder="CLABE, JSON, IVA…"
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="go"
          />
          <span class="buscador__cuenta etiqueta" data-cuenta aria-live="polite">{tools.length} piezas</span>
        </div>
      </div>
      <Piezas level={3} />
      <p class="caja__vacio titular" data-sin-resultados hidden>
        Esa pieza no está en la caja. Prueba con otra palabra o borra la búsqueda.
      </p>
    </section>

    <!-- Las apps: piezas más grandes, para Mac, y el cajón de las de Android. -->
    <section id="apps" class="apps" aria-labelledby="apps-titulo">
      <header class="apps__cabeza">
        <h2 id="apps-titulo" class="titular" data-entra>También hago apps</h2>
        <p data-entra>Para Mac y para Android. Nativas, ligeras y con la misma regla: tus datos se quedan contigo.</p>
      </header>
      <ul class="apps__lista" role="list">
        {apps.map((app) => {
          const Tag = app.href ? "a" : "div";
          return (
            <li data-entra>
              {/* Se publican desde otros repos: recarga completa, sin transición. */}
              <Tag href={app.href} class="pieza app" data-astro-reload={app.href ? true : undefined} data-astro-prefetch={app.href ? "false" : undefined}>
                <span class="pieza__arriba">
                  <img
                    src={`/img/apps/${app.slug}.png`}
                    alt=""
                    width="72"
                    height="72"
                    loading="lazy"
                    decoding="async"
                    class="app__icono"
                  />
                  {app.href ? (
                    <span class="pieza__flecha" aria-hidden="true">
                      <svg viewBox="0 0 16 16" focusable="false"><path d="M4.5 11.5l7-7M5.5 4.5h6v6" /></svg>
                    </span>
                  ) : (
                    <span class="app__pronto etiqueta">muy pronto</span>
                  )}
                </span>
                <span class="app__nombre titular">{app.title}</span>
                <span class="app__desc">{app.desc}</span>
              </Tag>
            </li>
          );
        })}
      </ul>
      <div class="android" data-entra>
        {/* /android/ no pasa por Layout.astro: recarga completa, sin transición. */}
        <a href="/android/" class="pieza android__enlace" data-astro-reload data-astro-prefetch="false">
          <span class="android__texto">
            <span class="etiqueta">android · {androidApps.length} apps</span>
            <span class="android__nombre titular">El cajón, para Android</span>
            <span class="android__desc">La quincena, los sobres, la rifa, el intercambio, las medicinas de tu mamá. Sin anuncios y sin cuenta.</span>
          </span>
          <span class="android__iconos" aria-hidden="true">
            {androidApps.map((a) => (
              <img src={`/img/android/${a.slug}/icono.png`} alt="" width="56" height="56" loading="lazy" decoding="async" />
            ))}
          </span>
          <span class="pieza__flecha" aria-hidden="true">
            <svg viewBox="0 0 16 16" focusable="false"><path d="M4.5 11.5l7-7M5.5 4.5h6v6" /></svg>
          </span>
        </a>
      </div>
    </section>

    <script type="application/ld+json" set:html={jsonLd} />
  </main>
</Layout>

<style>
  /* ---------- Portada ---------- */

  .portada {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: 1fr auto;
    gap: var(--hueco);
  }

  .portada__titulo {
    --pieza: var(--bloque-oscuro);
    grid-row: 1 / -1;
    justify-content: space-between;
    gap: 2.5rem;
    min-height: clamp(15rem, 30vw, 22rem);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    color: var(--crema-fija);
  }

  .portada__titulo .etiqueta {
    margin: 0;
  }

  .portada h1 {
    margin: 0;
    font-size: clamp(2.5rem, 1.2rem + 5.2vw, 5.75rem);
    line-height: 0.9;
  }
  .portada h1 span {
    color: var(--sol);
  }

  /* La mesa de pruebas: el único bloque blanco de la portada, con contorno. */
  .mesa {
    --d: 0.07s;
    --de: 1.5deg;
    display: flex;
    flex-direction: column;
    padding: clamp(1rem, 0.8rem + 1vw, 1.5rem);
    background: var(--panel);
    border: 2px solid var(--tinta);
    border-radius: var(--radio-pieza);
  }

  .mesa textarea {
    flex: 1;
    width: 100%;
    min-height: 4.5rem;
    margin: 0.35rem 0 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--tinta);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 2vw, 3rem);
    font-weight: 800;
    font-stretch: 90%;
    letter-spacing: -0.015em;
    line-height: 1.02;
    resize: none;
    caret-color: var(--coral);
  }
  .mesa textarea:focus-visible {
    outline: none;
  }
  .mesa:focus-within {
    outline: 3px solid var(--acento);
    outline-offset: 3px;
  }

  .mesa__nota {
    margin: 0.75rem 0 0;
    color: var(--gris);
    font-size: var(--t-s);
    line-height: 1.35;
  }

  .reglas {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    gap: var(--hueco);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .reglas li {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    padding: 0.5rem 1rem;
    color: var(--tinta-fija);
    font-size: var(--t-s);
    font-weight: 700;
    line-height: 1.1;
    border-radius: 1rem;
  }
  .reglas li:nth-child(1) { --d: 0.14s; background: var(--lila); }
  .reglas li:nth-child(2) { --d: 0.19s; --de: 1.5deg; background: var(--menta); }
  .reglas li:nth-child(3) { --d: 0.24s; background: var(--cielo); }

  @media (max-width: 900px) {
    .portada {
      grid-template-columns: minmax(0, 1fr);
    }
    .portada__titulo {
      grid-row: auto;
      min-height: 0;
    }
    .mesa textarea {
      min-height: 3.5rem;
    }
  }
  @media (max-width: 460px) {
    .reglas {
      grid-template-columns: 1fr 1fr;
    }
    .reglas li:nth-child(3) {
      grid-column: 1 / -1;
    }
  }

  /* ---------- La caja: buscador + piezas ---------- */

  .caja {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    scroll-margin-top: 0;
  }

  .buscador {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-bottom: clamp(1rem, 2.5vw, 1.5rem);
  }

  .buscador h2 {
    margin: 0;
    font-size: var(--t-l);
  }

  .buscador__campo {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    max-width: 30rem;
    min-width: min(100%, 16rem);
  }

  .buscador__campo svg {
    position: absolute;
    left: 0.9rem;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--tinta);
    stroke-width: 2.2;
    stroke-linecap: round;
    pointer-events: none;
  }

  .buscador input {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.35rem 6.5rem 0.35rem 2.75rem;
    border: 2px solid var(--tinta);
    border-radius: 1rem;
    background: var(--panel);
    color: var(--tinta);
    font: inherit;
    font-weight: 600;
  }

  .buscador input::placeholder {
    color: var(--gris);
    font-weight: 400;
  }

  .buscador input:focus-visible {
    outline: 3px solid var(--acento);
    outline-offset: 2px;
    border-radius: 1rem;
  }

  .buscador__cuenta {
    position: absolute;
    right: 0.9rem;
    color: var(--gris);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  .caja__vacio {
    margin: 2rem 0 0;
    max-width: 22ch;
    font-size: var(--t-l);
    line-height: 1.05;
  }

  /* ---------- Apps ---------- */

  .apps {
    padding-top: clamp(3.5rem, 8vw, 7rem);
  }

  .apps__cabeza {
    display: flex;
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 3rem;
    margin-bottom: clamp(1rem, 2.5vw, 1.5rem);
  }

  .apps__cabeza h2 {
    margin: 0;
    font-size: var(--t-xl);
    max-width: 14ch;
  }

  .apps__cabeza p {
    margin: 0;
    max-width: 30ch;
    color: var(--gris);
    font-size: var(--t-m);
    line-height: 1.3;
  }

  .apps__lista {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--hueco);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .apps__lista li {
    display: grid;
  }

  .app {
    --pieza: var(--panel);
    min-height: 17rem;
    padding: clamp(1.125rem, 0.9rem + 1vw, 1.75rem);
    color: var(--tinta);
    border: 2px solid var(--tinta);
  }
  .app :global(.pieza__flecha) {
    background: var(--tinta);
    color: var(--panel);
  }
  @media (hover: hover) {
    a.app:hover {
      --pieza: var(--sol);
      color: var(--tinta-fija);
      border-color: var(--tinta-fija);
    }
    .apps__lista li:nth-child(2) a.app:hover {
      --pieza: var(--coral);
    }
  }
  a.app {
    transition:
      translate 0.45s var(--ease-spring),
      rotate 0.45s var(--ease-spring),
      scale 0.2s var(--ease-soft),
      background-color 0.25s var(--ease-soft),
      color 0.25s var(--ease-soft);
  }

  .app__icono {
    width: 4.5rem;
    height: 4.5rem;
  }

  .app__pronto {
    padding: 0.3rem 0.65rem;
    background: var(--crema-honda);
    border-radius: 0.625rem;
  }

  .app__nombre {
    margin-top: auto;
    padding-top: 2rem;
    font-size: var(--t-l);
  }

  .app__desc {
    margin-top: 0.5rem;
    font-size: var(--t-s);
    line-height: 1.4;
  }

  .android {
    display: grid;
    margin-top: var(--hueco);
  }

  .android__enlace {
    --pieza: var(--bloque-oscuro);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1.125rem, 0.9rem + 1vw, 1.75rem);
    color: var(--crema-fija);
  }
  .android__enlace :global(.pieza__flecha) {
    align-self: start;
    background: var(--crema-fija);
    color: var(--tinta-fija);
  }
  @media (hover: hover) {
    .android__enlace:hover :global(.pieza__flecha) {
      background: var(--sol);
      color: var(--tinta-fija);
    }
  }

  .android__texto {
    display: grid;
    gap: 0.5rem;
  }

  .android__nombre {
    font-size: var(--t-l);
  }

  .android__desc {
    max-width: 46ch;
    font-size: var(--t-s);
    line-height: 1.4;
    opacity: 0.85;
  }

  .android__iconos {
    display: grid;
    grid-template-columns: repeat(5, 3.5rem);
    gap: 0.5rem;
  }
  .android__iconos img {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 28%;
  }

  @media (max-width: 900px) {
    .android__enlace {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .android__iconos {
      grid-row: 2;
      grid-column: 1 / -1;
      grid-template-columns: repeat(5, minmax(0, 3.5rem));
    }
    .android__iconos img {
      width: 100%;
      height: auto;
    }
    .apps__lista {
      grid-template-columns: minmax(0, 1fr);
    }
    .app {
      min-height: 0;
    }
  }
</style>
