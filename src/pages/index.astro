---
import Layout from "../layouts/Layout.astro";
import Rosette from "../components/brand/Rosette.astro";
import Motif from "../components/brand/Motif.astro";
import { categories, tools, toolsIn } from "../lib/tools";

const siteURL = new URL("/", Astro.site).href;
const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "gomflo.dev",
    url: siteURL,
    inLanguage: "es-MX",
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Herramientas online gratis",
    itemListElement: tools.map((tool, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: tool.title,
      url: new URL(tool.href, Astro.site).href,
    })),
  },
]).replace(/</g, "\\u003c");
---

<Layout
  title="gomflo.dev | Herramientas online gratis en español"
  image="/img/inicio.jpeg"
  imageAlt="gomflo.dev: herramientas online gratis en español"
  description="Herramientas online gratis en español: validar CLABE, calculadora de IVA, días hábiles, números a letras, romanos, código morse, JSON, contraseñas y más."
>
  <main id="main-content" class="home" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-text">
        <h1 id="hero-title" class="hero-title">
          Herramientas pequeñas para el trabajo de todos los días.
        </h1>
        <p class="hero-lead">
          Utilidades para desarrolladores que hacen una sola cosa y la hacen rápido.
          Sin cuentas y sin enviar tus datos a ningún lado.
        </p>
      </div>
      <div class="hero-art">
        <Rosette />
      </div>
    </section>

    {categories.map((category) => (
      <section class="group" aria-labelledby={`group-${category.id}`}>
        <header class="group-head">
          <h2 id={`group-${category.id}`} class="group-title">{category.title}</h2>
          <p class="group-desc">{category.desc}</p>
        </header>
        <ul class="panel" role="list">
          {toolsIn(category.id).map((tool) => (
            <li>
              <a href={tool.href} class="tile azulejo motif-trigger">
                <Motif slug={tool.slug} class="tile-motif" />
                <span class="tile-text">
                  <span class="tile-title">{tool.title}</span>
                  <span class="tile-desc">{tool.desc}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="group" aria-labelledby="group-apps">
      <header class="group-head">
        <h2 id="group-apps" class="group-title">Apps</h2>
        <p class="group-desc">Proyectos más grandes, con la misma regla: tus datos se quedan contigo.</p>
      </header>
      <ul class="panel panel-wide" role="list">
        <li>
          <a href="/susurro/" class="tile azulejo">
            <span class="tile-text">
              <span class="tile-title">Susurro</span>
              <span class="tile-desc">Dictado por voz para Mac. Mantén fn, habla y suelta: el texto aparece pulido en cualquier app, sin salir de tu equipo.</span>
            </span>
          </a>
        </li>
      </ul>
    </section>

    <script type="application/ld+json" set:html={jsonLd} />
  </main>
</Layout>

<style>
  .home {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* ---------- Hero ---------- */

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding: clamp(2rem, 6vw, 4.5rem) 0 clamp(3rem, 7vw, 5.5rem);
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.75rem, 6.6vw, 5.25rem);
    font-weight: 800;
    font-variation-settings: "wdth" 78;
    letter-spacing: -0.035em;
    line-height: 0.95;
    color: var(--ink);
    text-wrap: balance;
  }

  .hero-lead {
    margin: 1.5rem 0 0;
    max-width: 40ch;
    color: var(--ink-muted);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .hero-art {
    width: 100%;
    max-width: 26rem;
    justify-self: end;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .hero-art {
      max-width: 11.5rem;
      justify-self: start;
      order: -1;
    }
  }

  /* ---------- Grupos ---------- */

  .group + .group {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
  }

  .group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    margin-bottom: 1.25rem;
  }

  .group-title {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    font-variation-settings: "wdth" 80;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .group-desc {
    margin: 0;
    max-width: 44ch;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  /* ---------- Panel de azulejos ---------- */

  .panel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3px;
    margin: 0;
    padding: 3px;
    list-style: none;
    background: var(--grout);
    border-radius: 1.75rem;
    overflow: hidden;
  }

  .panel li {
    display: flex;
  }

  .panel-wide {
    grid-template-columns: 1fr;
  }

  .panel-wide .tile {
    min-height: 0;
    padding-inline: clamp(2.5rem, 5vw, 4rem);
  }

  .panel-wide .tile-desc {
    max-width: 60ch;
  }

  .tile {
    --orn-r: 40px;
    --seed-r: 9px;
    --orn-w: 3px;
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 16rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--ink);
    text-decoration: none;
    transition:
      --tile-bg 0.3s var(--ease-out),
      --orn 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }

  .tile :global(.tile-motif) {
    width: 4.5rem;
    height: 4.5rem;
    color: var(--cobalt);
    transition: color 0.3s var(--ease-out);
  }

  .tile-text {
    display: grid;
    gap: 0.375rem;
  }

  .tile-title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 750;
    font-variation-settings: "wdth" 85;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .tile-desc {
    max-width: 30ch;
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.4;
    transition: color 0.3s var(--ease-out);
  }

  .tile:hover,
  .tile:focus-visible {
    --tile-bg: var(--cobalt);
    --orn: color-mix(in oklab, var(--on-cobalt) 24%, transparent);
    color: var(--on-cobalt);
  }

  .tile:hover :global(.tile-motif),
  .tile:focus-visible :global(.tile-motif) {
    color: var(--on-cobalt);
  }

  .tile:hover .tile-desc,
  .tile:focus-visible .tile-desc {
    color: color-mix(in oklab, var(--on-cobalt) 82%, transparent);
  }

  .tile:focus-visible {
    outline: 3px solid var(--yolk);
    outline-offset: -7px;
    border-radius: 0;
  }

  @media (max-width: 900px) {
    .tile {
      min-height: 14rem;
    }
    .tile :global(.tile-motif) {
      width: 3.75rem;
      height: 3.75rem;
    }
  }

  @media (max-width: 680px) {
    .panel {
      grid-template-columns: 1fr;
      border-radius: 1.25rem;
    }
    .tile {
      --orn-r: 26px;
      --seed-r: 6px;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 1.125rem;
      min-height: 0;
      padding: 1.25rem 1.25rem 1.25rem 1.5rem;
    }
    .tile :global(.tile-motif) {
      flex: none;
      width: 3rem;
      height: 3rem;
    }
  }
</style>
